---
// Układ bazowy każdej strony: <head> z SEO/GEO, link „Przejdź do treści”, nawigacja W5 z paskiem postępu, <main>, stopka S14,
// boczny wskaźnik segmentów, przycisk i sheet dostępności, sheet „Opisz projekt”, okienko zgód.
// Warstwy makiety: W1 zeszyt w kratkę (body.kratka, stała), W2 baza segmentów (.baza), W5 stałe bloki, W6 sheet.
// Techniki SEO/GEO: treść w HTML bez potrzeby JS; jeden graf JSON-LD w Seo.astro; te same dane firmy wszędzie (stopka = JSON-LD = llms.txt).
import Seo from '../components/seo/Seo.astro';
import type { Podstrona } from '../lib/schema';
import BanerZgod from '../components/zgody/BanerZgod.astro';
import Nawigacja from '../components/wspolne/Nawigacja.astro';
import Stopka from '../components/wspolne/Stopka.astro';
import WskaznikSegmentow from '../components/wspolne/WskaznikSegmentow.astro';
import SheetDostepnosci from '../components/wspolne/SheetDostepnosci.astro';
import SheetProjekt from '../components/wspolne/SheetProjekt.astro';
import SheetPowiadom from '../components/wspolne/SheetPowiadom.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/animacje.css';

interface Props {
  strona: 'glowna' | 'strony-internetowe' | 'automatyzacje' | 'analiza-seo-geo' | 'realizacje' | 'pilotaze' | 'polityka-prywatnosci' | 'dostepnosc' | 'kontakt';
  nazwaStrony: string;
  okruszki?: { nazwa: string; url: string }[];
  podstrona?: Podstrona;
}
const { strona, nazwaStrony, okruszki, podstrona } = Astro.props;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <!-- Motyw i ustawienia dostępności przed pierwszym malowaniem (bez mignięcia). Zapis tylko w localStorage. -->
    <script is:inline>
      (function () {
        var h = document.documentElement; h.classList.add('js');
        try {
          var m = localStorage.getItem('fk-motyw');
          if (m === 'dark' || (!m && matchMedia('(prefers-color-scheme: dark)').matches)) h.dataset.theme = 'dark';
          var u = JSON.parse(localStorage.getItem('fk-dostepnosc') || '[]');
          u.forEach(function (k) { h.classList.add(k); });
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href="/fonts/schibsted-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/przejscia-realizacji.css" /> <!-- nazwy View Transitions realizacji (31b) -->
    <Seo strona={strona} nazwaStrony={nazwaStrony} okruszki={okruszki} podstrona={podstrona} />
  </head>
  <body class="kratka">
    <a class="pomin" href="#tresc">Przejdź do treści</a>
    <Nawigacja />
    {okruszki && okruszki.length > 1 && (
      <nav aria-label="Jesteś tutaj" class="okruszki kontener">
        <ol>{okruszki.map((o, i) => <li>{i === okruszki.length - 1 ? <span aria-current="page">{o.nazwa}</span> : <a href={o.url}>{o.nazwa}</a>}</li>)}</ol>
      </nav>
    )}
    <main id="tresc" tabindex="-1">
      <slot />
    </main>
    <Stopka />
    <WskaznikSegmentow />
    <SheetDostepnosci />
    <SheetProjekt />
    <SheetPowiadom />
    <BanerZgod />
    <script>
      import '../scripts/strona';
      import '../scripts/ruch';
    </script>
  </body>
</html>

<style>
  main { display: block; padding-top: var(--fk-wys-paska); }
  main:focus { outline: none; }
  @media (max-width: 1023.98px) { main { padding-top: 61px; } }
  .okruszki { padding-top: calc(var(--fk-wys-paska) + 16px); margin-bottom: -48px; position: relative; z-index: 1; }
  .okruszki ol { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; font-size: var(--fk-font-maly); }
  .okruszki li + li::before { content: '/'; margin-right: 8px; color: var(--fk-tekst-pomocniczy); }
</style>
