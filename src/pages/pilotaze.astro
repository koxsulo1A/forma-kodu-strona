---
// /pilotaze (makieta 32, komputer 1440 i telefon 375). Treść: panel Keystatic → „Strona 32: Darmowe pilotaże” (src/content/strony/pilotaze.json).
// Prawo: formularz pilotażu BEZ pola zgody (decyzja 1A, klauzula pod formularzem); „Powiadom mnie” / lista oczekujących z niezaznaczoną zgodą (decyzja 6B, wspólny sheet).
// S5 = FAQ z kolekcji (strony: pilotaze), te same pytania w JSON-LD FAQPage (Uklad).
import Uklad from '../layouts/Uklad.astro';
import { trescStrony } from '../lib/tresc';
import S1Hero from '../components/pilotaze/S1Hero.astro';
import S2Kategorie from '../components/pilotaze/S2Kategorie.astro';
import S3JakDziala from '../components/pilotaze/S3JakDziala.astro';
import S4Warunki from '../components/pilotaze/S4Warunki.astro';
import S5Faq from '../components/pilotaze/S5Faq.astro';
import S6Formularz from '../components/pilotaze/S6Formularz.astro';
import S7NieWiesz from '../components/pilotaze/S7NieWiesz.astro';

const t = await trescStrony('strona-pilotaze');
if (!t) throw new Error('Brak treści strony: src/content/strony/pilotaze.json');
const okruszki = [{ nazwa: 'Strona główna', url: '/' }, { nazwa: 'Pilotaże', url: '/pilotaze' }];
---
<Uklad strona="pilotaze" nazwaStrony="Darmowe pilotaże" okruszki={okruszki}>
  <S1Hero t={t.s1_hero} />
  <S2Kategorie t={t.s2_kategorie} />
  <S3JakDziala t={t.s3_jak_dziala} />
  <S4Warunki t={t.s4_warunki} />
  <S5Faq t={t.s5_faq} />
  <S6Formularz t={t.s6_formularz} />
  <S7NieWiesz t={t.s7_nie_wiesz} />
</Uklad>
