---
// /automatyzacje (makieta 29, komputer 1440 i telefon 375). Treść: panel Keystatic → „Strona 29: Automatyzacje” (src/content/strony/automatyzacje.json).
// Kolejność segmentów jak na makiecie: S1–S10, stopka w Uklad.astro. S9 = FAQ z kolekcji (odpowiedzi widoczne, wariant A).
import Uklad from '../layouts/Uklad.astro';
import { trescStrony } from '../lib/tresc';
import S1Hero from '../components/automatyzacje/S1Hero.astro';
import S2DlaKogo from '../components/automatyzacje/S2DlaKogo.astro';
import S3Zakres from '../components/automatyzacje/S3Zakres.astro';
import S4Boty from '../components/automatyzacje/S4Boty.astro';
import S5JakPracujemy from '../components/automatyzacje/S5JakPracujemy.astro';
import S6Ograniczenia from '../components/automatyzacje/S6Ograniczenia.astro';
import S7Cena from '../components/automatyzacje/S7Cena.astro';
import S8Przyklad from '../components/automatyzacje/S8Przyklad.astro';
import FaqKolumny from '../components/sekcje/FaqKolumny.astro';
import S10Zamkniecie from '../components/automatyzacje/S10Zamkniecie.astro';

const t = await trescStrony('strona-automatyzacje');
if (!t) throw new Error('Brak treści strony: src/content/strony/automatyzacje.json');
const okruszki = [{ nazwa: 'Strona główna', url: '/' }, { nazwa: 'Automatyzacje', url: '/automatyzacje' }];
---
<Uklad strona="automatyzacje" nazwaStrony="Automatyzacje i boty czatowe" okruszki={okruszki}>
  <S1Hero t={t.s1_hero} />
  <S2DlaKogo t={t.s2_dla_kogo} />
  <S3Zakres t={t.s3_zakres} />
  <S4Boty t={t.s4_boty} />
  <S5JakPracujemy t={t.s5_jak_pracujemy} />
  <S6Ograniczenia t={t.s6_ograniczenia} />
  <S7Cena t={t.s7_cena} />
  <S8Przyklad t={t.s8_przyklad} />
  <FaqKolumny strona="automatyzacje" naglowek={t.s9_faq.naglowek} nr="S9" uklad="lista" />
  <S10Zamkniecie t={t.s10_zamkniecie} />
</Uklad>
