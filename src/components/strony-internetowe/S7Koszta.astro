---
// 28 S7 Koszta po stronie klienta (wariant A): cztery kolumny z pionową linią. Kwoty z rynku: każda ma źródło i datę w panelu (walidacja nr 1),
// pokazane w podpisie pod kwotą. Telefon: siatka 2×2 (sekcja informacyjna, bez swipe).
interface Props { t: any }
const { t } = Astro.props;
const zaslepka = (s: string) => /^\[.*\]$/.test(s);
---
<section class="s7 baza segment" id="koszta" data-segment="S7 Koszta klienta" aria-labelledby="s7-h">
  <div class="kontener s7-wnetrze">
    <header class="naglowek">
      <h2 id="s7-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.etykieta && <p class="t-etykieta znacznik">{t.etykieta}</p>}
    </header>
    <dl class="kwoty">
      {t.pozycje.map((p: any) => (
        <div>
          <dt class="t-h4 naglowkowy">{p.nazwa}</dt>
          <dd class="t-h3 akcentowy">{p.zakres}</dd>
          <dd class="t-maly pomocniczy">{p.okres}</dd>
          <dd class="t-etykieta pomocniczy zrodlo">Źródło: {zaslepka(p.zrodlo) ? 'do uzupełnienia' : p.zrodlo}{zaslepka(p.data) ? '' : `, ${p.data}`}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .s7 { padding-block: clamp(40px, 4.5vw, 64px) clamp(32px, 3.5vw, 48px); }
  .s7-wnetrze { display: grid; gap: 20px; }
  .naglowek { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .znacznik { padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); }
  .kwoty { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding-block: 20px; }
  .kwoty > div { display: grid; gap: 4px; align-content: start; padding-inline: 28px; }
  .kwoty > div:first-child { padding-left: 0; }
  .kwoty > div + div { border-left: 1px solid var(--fk-obrys); }
  .zrodlo { padding-top: 4px; }
  @media (max-width: 1023.98px) {
    .kwoty { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 0; padding-block: 8px; }
    .kwoty > div { padding-inline: 16px; }
    .kwoty > div:nth-child(odd) { padding-left: 0; border-left: 0; }
  }
</style>
