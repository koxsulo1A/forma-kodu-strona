---
// 28 S2 Dla kogo (wariant A): trzy kolumny z linią akcentu. Telefon: jedna karta swipe ze wskaźnikiem od 01 (zasada mobile 28).
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s2 baza segment" id="dla-kogo" data-segment="S2 Dla kogo" aria-labelledby="s2-h">
  <div class="kontener s2-wnetrze">
    <header class="naglowek">
      <h2 id="s2-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l pomocniczy">{t.lead}</p>}
    </header>
    <ul role="list" class="kolumny swipe" data-swipe="s2-wskaznik">
      {t.branze.map((b: any) => <li><h3 class="t-h3 naglowkowy">{b.branza}</h3><p class="t-tresc">{b.opis}</p></li>)}
    </ul>
    <div class="wskaznik-swipe" id="s2-wskaznik" aria-hidden="true">
      <ol>{t.branze.map((_: any, i: number) => <li aria-current={String(i === 0)}></li>)}</ol>
      <span data-licznik>1 z {t.branze.length}</span>
    </div>
  </div>
</section>

<style>
  .s2 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s2-wnetrze { display: grid; gap: 24px; }
  .naglowek { display: grid; gap: 12px; max-width: 820px; }
  .kolumny { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .kolumny li { display: grid; gap: 12px; align-content: start; padding-top: 12px; border-top: 2px solid var(--fk-akcent); }
  @media (max-width: 1023.98px) {
    .kolumny li { padding: 20px; border: 1px solid var(--fk-obrys); border-top: 2px solid var(--fk-akcent); border-radius: var(--radius-12); background: var(--fk-tlo-powierzchnia); }
  }
</style>
