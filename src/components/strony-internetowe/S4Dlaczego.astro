---
// 28 S4 Dlaczego my (wariant B): nagłówek przyklejony po lewej (sticky), po prawej lista 01–06 rozdzielona liniami.
// Telefon: nagłówek nad listą, lista zostaje listą (to treść informacyjna na całą szerokość).
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s4 baza segment" id="dlaczego" data-segment="S4 Dlaczego my" aria-labelledby="s4-h">
  <div class="kontener s4-wnetrze">
    <header class="naglowek">
      <h2 id="s4-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l pomocniczy">{t.lead}</p>}
    </header>
    <ol role="list" class="lista">
      {t.punkty.map((p: any, i: number) => (
        <li><span class="t-liczba akcentowy" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3 class="t-h4 naglowkowy">{p.tytul}</h3><p class="t-tresc">{p.opis}</p></div></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .s4 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s4-wnetrze { display: grid; grid-template-columns: minmax(0, 440fr) minmax(0, 792fr); gap: 80px; align-items: start; }
  .naglowek { display: grid; gap: 12px; position: sticky; top: calc(var(--fk-wys-paska) + 24px); }
  .lista { border-top: 1px solid var(--fk-obrys-kontrolka); }
  .lista li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--fk-obrys); }
  .lista li > div { display: grid; gap: 8px; }
  @media (max-width: 1023.98px) {
    .s4-wnetrze { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .naglowek { position: static; }
    .lista li { grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding: 20px 0; }
  }
</style>
