---
// 28 S12 Realizacje (wariant D): duża karta po lewej (pierwsza wybrana realizacja), dwie mniejsze po prawej.
// Dane z kolekcji „Realizacje” (jedno źródło, wybór ręczny w panelu). Makieta ma 3 wymyślone karty „przykład”: kod pokazuje prawdziwe projekty z kolekcji.
// Telefon: jedna karta swipe w pętli bez końca (zasada mobile 28: listy realizacji = infinite loop).
import { realizacjeWybrane } from '../../lib/tresc';
interface Props { t: any }
const { t } = Astro.props;
const lista = await realizacjeWybrane(t.realizacje);
const typ = (e: any) => (e.typ === 'klient' ? 'strona klienta' : e.typ === 'projekt własny' ? 'projekt własny' : 'przykład');
const status = (e: any) => (e.status === 'w toku' ? 'w przygotowaniu' : 'zakończony');
const link = (r: any) => (r.entry.typ === 'przykład układu' ? null : `/realizacje/${r.slug}`);
---
{lista.length > 0 && (
  <section class="s12 baza segment" id="realizacje" data-segment="S12 Realizacje" aria-labelledby="s12-h">
    <div class="kontener s12-wnetrze">
      <header class="naglowek">
        <h2 id="s12-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
        {t.lead && <p class="t-tresc-l pomocniczy">{t.lead}</p>}
      </header>
      <ul role="list" class="karty swipe" data-swipe="s12-wskaznik" data-petla>
        {lista.map((r, i) => (
          <li class:list={['karta', { duza: i === 0 }]}>
            <p class="etykiety"><span class="t-etykieta znacznik">{r.entry.kategoria}</span><span class="t-etykieta znacznik akcentowy">{typ(r.entry)}</span></p>
            <h3 class:list={[i === 0 ? 't-h3' : 't-h4', 'naglowkowy']}>{link(r) ? <a href={link(r)}>{r.entry.naglowek}</a> : r.entry.naglowek}</h3>
            <p class:list={[i === 0 ? 't-tresc-l' : 't-tresc']}>{r.entry.opis}</p>
            <p class="t-maly pomocniczy">Status: {status(r.entry)}</p>
          </li>
        ))}
      </ul>
      <div class="wskaznik-swipe" id="s12-wskaznik" aria-hidden="true">
        <ol>{lista.map((_, i) => <li aria-current={String(i === 0)}></li>)}</ol>
        <span data-licznik>1 z {lista.length}</span>
      </div>
    </div>
  </section>
)}

<style>
  .s12 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s12-wnetrze { display: grid; gap: 24px; }
  .naglowek { display: grid; gap: 12px; max-width: 900px; }
  .karty { display: grid; grid-template-columns: minmax(0, 776fr) minmax(0, 520fr); grid-auto-rows: auto; gap: 16px; }
  .karta { position: relative; display: grid; gap: 16px; align-content: start; padding: 28px 32px 32px; border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); transition: border-color var(--fk-czas-szybki); }
  .karta:hover { border-color: var(--fk-obrys-kontrolka); }
  .karta.duza { grid-row: span 2; padding: 40px; background: var(--fk-tlo-podniesione); align-content: end; min-height: 420px; }
  .karta:only-child { grid-column: 1 / -1; min-height: 0; }
  .etykiety { display: flex; flex-wrap: wrap; gap: 8px; }
  .znacznik { padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo); }
  .karta a { color: inherit; text-decoration: none; }
  .karta a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .karta:focus-within { outline: 3px solid var(--fk-fokus); outline-offset: 3px; }
  .karta a:focus-visible { outline: none; }
  @media (max-width: 1023.98px) {
    .karta, .karta.duza { padding: 24px 20px; min-height: 0; }
  }
</style>
