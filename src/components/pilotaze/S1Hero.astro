---
// 32 S1 Hero (wariant B): plakietka, wyśrodkowany nagłówek, 2 akapity, przycisk do formularza; pod spodem pasek „W skrócie” (4 fakty z ✓).
// Telefon: fakty jako jedna karta swipe ze wskaźnikiem od 01 (zasada 28).
import Ikona from '../wspolne/Ikona.astro';
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s1 baza segment" id="start" data-segment="S1 Hero" aria-labelledby="s1-h">
  <div class="kontener s1-wnetrze">
    <div class="srodek">
      {t.etykieta && <p><span class="t-etykieta plak">{t.etykieta}</span></p>}
      <h1 id="s1-h" class="t-display naglowkowy">{t.h1}</h1>
      <p class="t-tresc-l">{t.lead}</p>
      {t.lead_2 && <p class="t-tresc pomocniczy">{t.lead_2}</p>}
      <p><a class="przycisk przycisk--akcent" href="#zgloszenie">{t.cta}</a></p>
    </div>
    <h2 class="sr-only">W skrócie</h2>
    <ul role="list" class="fakty swipe" data-swipe="s1-wskaznik">
      {t.fakty.map((f: string) => <li class="t-tresc"><span class="ok" aria-hidden="true"><Ikona nazwa="check" rozmiar={16} /></span>{f}</li>)}
    </ul>
    <div class="wskaznik-swipe" id="s1-wskaznik" aria-hidden="true"><ol>{t.fakty.map((_: string, i: number) => <li aria-current={String(i === 0)}></li>)}</ol><span data-licznik>1 z {t.fakty.length}</span></div>
  </div>
</section>

<style>
  .s1 { padding-block: clamp(32px, 5vw, 72px) clamp(40px, 5vw, 64px); }
  .s1-wnetrze { display: grid; gap: 32px; }
  .srodek { display: grid; gap: 20px; justify-items: center; text-align: center; max-width: 960px; margin-inline: auto; }
  .plak { display: inline-block; padding: 4px 14px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo-powierzchnia); }
  .fakty { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); }
  .fakty li { display: grid; gap: 10px; align-content: start; padding: 24px 28px; }
  .fakty li + li { border-left: 1px solid var(--fk-obrys); }
  .ok { color: var(--fk-zielen-srednia); display: grid; }
  @media (max-width: 1023.98px) {
    .srodek { text-align: left; justify-items: start; }
    .srodek > p { width: 100%; }
    .srodek .przycisk { width: 100%; justify-content: center; }
    .fakty { background: none; border: 0; }
    .fakty li { border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys) !important; padding: 20px; }
  }
</style>
