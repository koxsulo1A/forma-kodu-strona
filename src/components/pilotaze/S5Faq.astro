---
// 32 S5 FAQ (Figma 224:1141, wariant D): biała baza W2, panel odpowiedzi jest wycięciem (widać kratkę W1) z ciemnym obrysem;
// spis pytań po lewej (zakładki pionowe), panel odpowiedzi po prawej. Kacper 25.11 16:06: 1:1 z Figmą. Strona.ts 9: klik, strzałki ←/→, Home/End.
// Pytania z kolekcji FAQ (strony: pilotaze). Bez JS: spis ukryty, wszystkie odpowiedzi widoczne pod pytaniami. Telefon: spis nad panelem.
import { getCollection, render } from 'astro:content';
import Ikona from '../wspolne/Ikona.astro';
interface Props { t: any }
const { t } = Astro.props;
const faq = (await getCollection('faq', (f) => f.data.strony.includes('pilotaze'))).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const pytania = await Promise.all(faq.map(async (f) => ({ pytanie: f.data.pytanie, Tresc: (await render(f)).Content })));
const start = Math.min(2, pytania.length - 1); // makieta: otwarte „Kto wykonuje pracę?”
---
<section class="s5 baza segment" id="pytania" data-segment="S5 FAQ" aria-labelledby="s5-h">
  <div class="kontener s5-wnetrze">
    <h2 id="s5-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
    <div class="uklad">
      <div role="tablist" aria-label="Pytania" aria-orientation="vertical" class="spis" hidden>
        {pytania.map((p, i) => (
          <button type="button" role="tab" id={`s5-z-${i}`} aria-controls={`s5-o-${i}`} aria-selected={String(i === start)} tabindex={i === start ? 0 : -1}>
            <span>{p.pytanie}</span><Ikona nazwa="caret" rozmiar={20} class="strzalka" />
          </button>
        ))}
      </div>
      <div class="panele">
        {pytania.map((p, i) => (
          <div role="tabpanel" id={`s5-o-${i}`} aria-labelledby={`s5-z-${i}`} class="panel w1 wyciecie" tabindex="0">
            <h3 class="pytanie-panelu naglowkowy">{p.pytanie}</h3>
            <div class="odp"><p.Tresc /></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .s5 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s5-wnetrze { display: grid; gap: 40px; }
  .s5-wnetrze > h2 { max-width: 760px; }
  .uklad { display: grid; grid-template-columns: minmax(0, 480fr) minmax(0, 800fr); gap: 32px; align-items: start; }
  .spis { display: grid; gap: 4px; }
  .spis[hidden] { display: none; }
  .spis button { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 54px; padding: 14px 16px; text-align: left; font: inherit; font-size: 17px; line-height: 1.55; color: var(--fk-tekst); background: none; border: 1px solid transparent; border-radius: 12px; cursor: pointer; }
  .spis button:hover { background: var(--fk-tlo-powierzchnia); }
  .spis button[aria-selected='true'] { background: var(--fk-tlo-powierzchnia); border-color: var(--fk-obrys-kontrolka); color: var(--fk-tekst-naglowek); }
  .spis button:focus-visible { outline: 3px solid var(--fk-fokus); outline-offset: 2px; }
  .spis :global(.strzalka) { flex: none; transform: rotate(-90deg); color: var(--fk-tekst-pomocniczy); }
  .spis button[aria-selected='true'] :global(.strzalka) { color: var(--fk-akcent); }
  .panele { display: grid; gap: 16px; }
  .panel { display: grid; gap: 16px; padding: 40px 48px; }
  .panel.w1.w1.w1.w1 { border: 1px solid var(--fk-tekst-naglowek); border-radius: 20px; }
  .pytanie-panelu { font-size: 30px; font-weight: 600; line-height: 1.2; }
  .odp { font-size: 19px; line-height: 1.55; color: var(--fk-tekst); }
  .odp :global(p) { margin: 0; }
  .odp :global(p + p) { margin-top: 12px; }
  .panel[hidden] { display: none; }
  .panel:focus-visible { outline: 3px solid var(--fk-fokus); outline-offset: 3px; }
  :global(html:not(.js)) .uklad { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 1023.98px) {
    .uklad { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .spis button { font-size: 16px; }
    .panel { padding: 24px 20px; }
    .pytanie-panelu { font-size: 22px; }
    .odp { font-size: 17px; }
  }
</style>
