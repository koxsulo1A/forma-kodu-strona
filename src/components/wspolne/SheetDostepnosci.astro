---
// W9 przycisk dostępności (stały, prawy dolny róg, 56×56) + W10 sheet z przełącznikami.
// Przełączniki zmieniają klasę na <html> i zapisują wybór w localStorage (nie cookie): większy tekst, mocniejszy kontrast, bez animacji.
---
<button type="button" class="dostepnosc-przycisk tylko-js" aria-label="Ustawienia dostępności" aria-haspopup="dialog" data-otworz-sheet="sheet-dostepnosc">
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <circle cx="14" cy="14" r="11.78" stroke="currentColor" stroke-width="2.1" />
    <circle cx="14" cy="7.47" r="2.1" fill="currentColor" />
    <rect x="7" y="11.2" width="14" height="2.1" rx="1.05" fill="currentColor" />
    <rect x="12.95" y="12.25" width="2.1" height="7" fill="currentColor" />
    <rect x="10.97" y="18.2" width="2.1" height="7.23" rx="1.05" transform="rotate(20 10.97 18.2)" fill="currentColor" />
    <rect x="15.17" y="18.9" width="2.1" height="7.23" rx="1.05" transform="rotate(-20 15.17 18.9)" fill="currentColor" />
  </svg>
</button>

<dialog id="sheet-dostepnosc" class="sheet" aria-labelledby="sheet-dostepnosc-h">
  <div class="sheet-naglowek">
    <h2 id="sheet-dostepnosc-h" class="t-h4">Ustawienia dostępności</h2>
    <button type="button" class="sheet-zamknij" aria-label="Zamknij" data-zamknij-sheet>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </div>
  <p class="t-tresc">Zmiany działają tylko w tej przeglądarce. Zapamiętamy je na tym urządzeniu.</p>
  <ul role="list" class="przelaczniki">
    {[
      { klasa: 'wiekszy-tekst', nazwa: 'Większy tekst' },
      { klasa: 'kontrast', nazwa: 'Mocniejszy kontrast' },
      { klasa: 'bez-ruchu', nazwa: 'Bez animacji' },
    ].map((p) => (
      <li>
        <span class="t-tresc-mocna" id={`przel-${p.klasa}`}>{p.nazwa}</span>
        <button type="button" role="switch" aria-checked="false" aria-labelledby={`przel-${p.klasa}`} class="przelacznik" data-przelacznik={p.klasa}><span aria-hidden="true"></span></button>
      </li>
    ))}
  </ul>
  <p class="t-maly pomocniczy">Więcej o dostępności strony: <a href="/dostepnosc">Deklaracja dostępności</a>.</p>
</dialog>

<style>
  .dostepnosc-przycisk {
    position: fixed; left: 12px; top: 50%; transform: translateY(-50%); z-index: 45; width: 56px; height: 56px; border-radius: 28px;
    display: grid; place-items: center; background: var(--fk-przelamanie); color: var(--fk-przelamanie-tekst);
    border: 2px solid var(--fk-kafel-3-tlo); box-shadow: var(--fk-cien-zakladka);
  }
  .dostepnosc-przycisk:focus-visible { outline-color: var(--fk-akcent); }
  /* Kacper 25.11: przycisk WCAG po lewej, na wysokości środka ekranu. Na komputerze to zakładka przyklejona
     do lewej krawędzi (28 px), żeby nie zasłaniała nagłówków; po najechaniu lub fokusie wysuwa się do 52 px. */
  @media (min-width: 768px) {
    .dostepnosc-przycisk {
      left: 0; width: 28px; height: 56px; border-radius: 0 14px 14px 0; border-left: 0; overflow: hidden;
      transition: width var(--fk-czas-szybki) var(--fk-krzywa-standard);
    }
    .dostepnosc-przycisk svg { width: 20px; height: 20px; flex: none; }
    .dostepnosc-przycisk:is(:hover, :focus-visible) { width: 52px; }
  }
  /* Telefon: lewy dolny róg, 16 px marginesu. */
  @media (max-width: 767.98px) { .dostepnosc-przycisk { top: auto; bottom: 16px; transform: none; width: 48px; height: 48px; } }
  .przelaczniki { display: grid; gap: 16px; margin-block: 24px; }
  .przelaczniki li { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .przelacznik { position: relative; width: 52px; height: 28px; border-radius: 14px; border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo-podniesione); flex: none; }
  .przelacznik span { position: absolute; left: 2px; top: 2px; width: 22px; height: 22px; border-radius: 50%; background: var(--fk-tlo); transition: transform var(--fk-czas-szybki) var(--fk-krzywa-standard); }
  .przelacznik[aria-checked='true'] { background: var(--fk-akcent); border-color: var(--fk-akcent); }
  .przelacznik[aria-checked='true'] span { transform: translateX(24px); }
</style>
