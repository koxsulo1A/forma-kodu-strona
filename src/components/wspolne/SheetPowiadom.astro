---
// Sheet „Powiadom mnie” (usługi „wkrótce”). Otwiera go każdy przycisk z data-otworz-sheet="sheet-powiadom" i data-usluga="…" (nazwa trafia do zgody i do ukrytego pola).
import FormularzPowiadom from './FormularzPowiadom.astro';
---
<dialog id="sheet-powiadom" class="sheet" aria-labelledby="sheet-powiadom-h">
  <div class="sheet-naglowek">
    <h2 id="sheet-powiadom-h" class="t-h4">Powiadom mnie o starcie</h2>
    <button type="button" class="sheet-zamknij" aria-label="Zamknij" data-zamknij-sheet>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </div>
  <p class="t-tresc sheet-lead">Usługa: <strong data-usluga-nazwa>wybrana usługa</strong>. Wyślemy jedną wiadomość, gdy ruszy.</p>
  <FormularzPowiadom id="sheet-pw" usluga="wybrana usługa" />
</dialog>
