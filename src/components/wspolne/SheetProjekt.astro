---
// Sheet „Opisz projekt” (R19, 398:330): komputer = panel 560 px z prawej, telefon = od dołu. <dialog> daje blokadę tła, Esc i powrót fokusu.
import FormularzProjektu from './FormularzProjektu.astro';
---
<dialog id="sheet-projekt" class="sheet" aria-labelledby="sheet-projekt-h">
  <div class="sheet-naglowek">
    <h2 id="sheet-projekt-h" class="t-h4">Opisz swój projekt</h2>
    <button type="button" class="sheet-zamknij" aria-label="Zamknij" data-zamknij-sheet>
      <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1l10 10M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </div>
  <p class="t-tresc sheet-lead">Kilka zdań o firmie i o tym, co chcesz zmienić. Odpowiemy na podany adres e-mail.</p>
  <FormularzProjektu id="sheet" />
</dialog>
