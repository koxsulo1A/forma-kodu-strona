---
// W5 Nawigacja (makieta 27, ramka „W5 Nawigacja / Landing (z Pilotażami)”) + pasek postępu przewijania + menu mobilne (398:2122).
// Zachowanie (zasada każdej makiety): pasek chowa się przy przewijaniu w dół i wraca przy przewijaniu w górę (próg 80 px, token prog/nawigacja-przewiniecie).
// Pod paskiem fioletowy pasek postępu 0–100%. Gdy pasek schowany, po prawej pojawia się boczny wskaźnik segmentów (WskaznikSegmentow.astro).
// Przyciski: W1 (linki), W2 (Opisz projekt), W3 (menu < 1024 px), W12 (motyw). Bez JS: linki widoczne, menu i motyw ukryte.
import Logo from './Logo.astro';
import { getEntry } from 'astro:content';
// Kacper 25.11: rozwijane przyciski Oferta, Pilotaże, Realizacje, Case study, Kontakt (panel rozwija się w dół, jak opis „Linki” 93:38).
const firma = (await getEntry('firma', 'firma'))!.data;
type Pozycja = { url?: string; nazwa: string; opis?: string; sheet?: boolean; wkrotce?: boolean };
// link: grupa bez rozwijania, zwykły link (Kacper 28.11: „Realizacje” prowadzi prosto na /realizacje).
const grupy: { id: string; nazwa: string; sciezki: string[]; pozycje: Pozycja[]; notka?: string; link?: string }[] = [
  { id: 'oferta', nazwa: 'Oferta', sciezki: ['/strony-internetowe', '/automatyzacje', '/analiza-seo-geo'], pozycje: [
    { url: '/strony-internetowe', nazwa: 'Strony internetowe', opis: 'Od strony na szablonie po stronę pisaną od zera.' },
    { url: '/automatyzacje', nazwa: 'Automatyzacje', opis: 'Boty, przypomnienia i formularze, które pracują same.' },
    { url: '/analiza-seo-geo', nazwa: 'Analiza SEO/GEO', opis: 'Jak widzą Cię Google i asystenci AI.', wkrotce: true },
    { url: '/#cennik', nazwa: 'Cennik', opis: 'Pakiety na start i koszty stałe.' },
  ] },
  { id: 'pilotaze', nazwa: 'Pilotaże', sciezki: ['/pilotaze'], pozycje: [
    { url: '/pilotaze#jak-dziala', nazwa: 'Jak działa pilotaż', opis: 'Krok po kroku, od zgłoszenia do wyniku.' },
    { url: '/pilotaze#kategorie', nazwa: 'Dla jakich firm', opis: 'Kategorie, w których szukamy firm.' },
    { url: '/pilotaze#warunki', nazwa: 'Warunki', opis: 'Co robimy my, a co Ty.' },
    { url: '/pilotaze#zgloszenie', nazwa: 'Zgłoś firmę', opis: 'Krótki formularz zgłoszeniowy.' },
  ] },
  { id: 'realizacje', nazwa: 'Realizacje', sciezki: ['/realizacje'], link: '/realizacje', pozycje: [] },
  { id: 'case-study', nazwa: 'Case study', sciezki: [], notka: 'Pierwsze opisy z liczbami (przed i po) opublikujemy po zakończeniu pilotażu.', pozycje: [
    { url: '/realizacje', nazwa: 'Zobacz realizacje', opis: 'Na razie: co zrobiliśmy i jak to sprawdzić.' },
    { url: '/pilotaze', nazwa: 'Zostań pierwszym case study', opis: 'Zgłoś firmę do pilotażu.' },
  ] },
  { id: 'kontakt', nazwa: 'Kontakt', sciezki: ['/kontakt'], pozycje: [
    { url: '/kontakt', nazwa: 'Opisz projekt', opis: 'Formularz: odpowiadamy na e-mail.', sheet: true },
    { url: `mailto:${firma.email}`, nazwa: firma.email, opis: 'Napisz bezpośrednio.' },
  ], notka: 'Biuro: poniedziałek–piątek, 9:00–17:00.' },
];
const sciezka = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="pasek" data-pasek>
  <div class="pasek-wnetrze">
    <a class="pasek-logo" href="/" aria-label="Forma Kodu, strona główna"><Logo /></a>
    <nav class="pasek-linki" aria-label="Główna">
      <ul role="list" class="grupy">
        {grupy.map((g) => g.link ? (
          <li class="grupa">
            <a class="t-maly grupa-przycisk" href={g.link} aria-current={g.sciezki.includes(sciezka) ? 'page' : undefined}>{g.nazwa}</a>
          </li>
        ) : (
          <li class="grupa" data-grupa>
            <button type="button" class="t-maly grupa-przycisk" aria-expanded="false" aria-controls={`panel-${g.id}`} data-grupa-przycisk
              aria-current={g.sciezki.includes(sciezka) ? 'page' : undefined}>
              {g.nazwa}
              <svg class="grupa-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="panel" id={`panel-${g.id}`} data-panel>
              <ul role="list" class="panel-lista">
                {g.pozycje.map((x) => (
                  <li>
                    <a href={x.url} class="panel-link" data-otworz-sheet={x.sheet ? 'sheet-projekt' : undefined} aria-haspopup={x.sheet ? 'dialog' : undefined}>
                      <span class="t-przycisk naglowkowy">{x.nazwa}{x.wkrotce && <span class="t-etykieta wkrotce"> wkrótce</span>}</span>
                      {x.opis && <span class="t-maly pomocniczy">{x.opis}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {g.notka && <p class="t-maly pomocniczy panel-notka">{g.notka}</p>}
            </div>
          </li>
        ))}
      </ul>
    </nav>
    <div class="pasek-akcje">
      <button type="button" class="motyw tylko-js" role="switch" aria-checked="false" aria-label="Ciemny motyw" data-motyw>
        <span class="motyw-slonce" aria-hidden="true"></span><span class="motyw-ksiezyc" aria-hidden="true"></span><span class="motyw-kciuk" aria-hidden="true"></span>
      </button>
      <a class="przycisk przycisk--glowny pasek-cta" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">Opisz projekt</a>
      <button type="button" class="menu-przycisk tylko-js" aria-expanded="false" aria-controls="menu-mobilne" aria-label="Otwórz menu" data-otworz-menu>
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
  <div class="postep" aria-hidden="true"><div class="postep-wypelnienie" data-postep></div></div>
</header>

<dialog id="menu-mobilne" class="menu-mobilne" aria-label="Menu">
  <div class="menu-gora">
    <a href="/" aria-label="Forma Kodu, strona główna"><Logo /></a>
    <button type="button" class="menu-przycisk" aria-label="Zamknij menu" data-zamknij-menu>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav aria-label="Główna (telefon)">
    <ul role="list" class="menu-lista">
      {grupy.map((g) => g.link ? (
        <li class="menu-grupa"><a class="t-h4 menu-link" href={g.link} data-link-menu>{g.nazwa}</a></li>
      ) : (
        <li>
          <details class="menu-grupa">
            <summary class="t-h4"><span>{g.nazwa}</span><span class="t-etykieta pomocniczy" aria-hidden="true">+</span></summary>
            <ul role="list" class="menu-podlista">
              {g.pozycje.map((x) => (
                <li><a href={x.url} data-link-menu data-otworz-sheet={x.sheet ? 'sheet-projekt' : undefined} aria-haspopup={x.sheet ? 'dialog' : undefined}>
                  <span class="t-przycisk naglowkowy">{x.nazwa}{x.wkrotce && <span class="t-etykieta wkrotce"> wkrótce</span>}</span>
                  {x.opis && <span class="t-maly pomocniczy">{x.opis}</span>}
                </a></li>
              ))}
            </ul>
            {g.notka && <p class="t-maly pomocniczy panel-notka">{g.notka}</p>}
          </details>
        </li>
      ))}
    </ul>
  </nav>
  <a class="przycisk przycisk--akcent przycisk--pelny" href="/kontakt" data-otworz-sheet="sheet-projekt" data-link-menu aria-haspopup="dialog">Opisz projekt</a>
</dialog>

<style>
  .pasek {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: var(--fk-tlo-powierzchnia); border-bottom: 1px solid var(--fk-obrys);
    transition: transform var(--fk-czas-standard) var(--fk-krzywa-standard);
  }
  :global(html.pasek-schowany) .pasek { transform: translateY(calc(-1 * var(--fk-wys-paska))); }
  .pasek-wnetrze {
    height: var(--fk-wys-paska); display: flex; align-items: center; gap: 24px;
    width: min(100% - 2 * var(--fk-margines), var(--fk-szerokosc)); margin-inline: auto;
  }
  .pasek-logo { flex: none; border-radius: 4px; }
  .pasek-linki { flex: 1; display: flex; justify-content: center; }
  .grupy { display: flex; gap: 8px; }
  .grupa { position: relative; }
  .grupa-przycisk {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border: 0; border-radius: var(--radius-pill);
    background: none; color: var(--fk-tekst); cursor: pointer;
  }
  .grupa-przycisk:hover, .grupa-przycisk[aria-expanded='true'] { background: var(--fk-tlo-podniesione); color: var(--fk-tekst-naglowek); }
  .grupa-przycisk[aria-current='page'] { color: var(--fk-tekst-naglowek); text-decoration: underline; text-underline-offset: 4px; }
  .grupa-caret { transition: transform var(--fk-czas-szybki) var(--fk-krzywa-standard); }
  .grupa-przycisk[aria-expanded='true'] .grupa-caret { transform: rotate(180deg); }
  /* Panel rozwija się w dół pod przyciskiem (najechanie, klik, klawiatura). Bez JS: panel otwiera się na najechanie i fokus. */
  .panel {
    position: absolute; top: calc(100% + 12px); left: 50%; width: 340px; padding: 12px; z-index: 5;
    background: var(--fk-tlo); border: 1px solid var(--fk-obrys); border-radius: var(--radius-card);
    box-shadow: 0 18px 40px -18px rgb(16 24 40 / 0.35);
    opacity: 0; visibility: hidden; transform: translate(-50%, -6px);
    transition: opacity var(--fk-czas-szybki) var(--fk-krzywa-wejscie), transform var(--fk-czas-szybki) var(--fk-krzywa-wejscie), visibility 0s linear var(--fk-czas-szybki);
  }
  .panel::before { content: ''; position: absolute; inset: -14px 0 auto; height: 14px; } /* mostek: kursor nie gubi panelu */
  .grupa.otwarta .panel, :global(html:not(.js)) .grupa:is(:hover, :focus-within) .panel {
    opacity: 1; visibility: visible; transform: translate(-50%, 0); transition-delay: 0s;
  }
  .panel-lista { display: grid; gap: 2px; }
  .panel-link { display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--radius-12); text-decoration: none; color: inherit; }
  .panel-link:hover, .panel-link:focus-visible { background: var(--fk-tlo-powierzchnia); }
  .wkrotce { color: var(--fk-akcent); }
  .panel-notka { padding: 10px 12px 4px; border-top: 1px solid var(--fk-obrys); margin-top: 6px; }
  .pasek-akcje { display: flex; align-items: center; gap: 16px; margin-left: auto; }

  .motyw {
    position: relative; width: 52px; height: 28px; border-radius: 14px; padding: 0;
    background: var(--fk-tlo-podniesione); border: 1px solid var(--fk-obrys-kontrolka);
  }
  .motyw span { position: absolute; border-radius: 50%; }
  .motyw-slonce { width: 10px; height: 10px; left: 8px; top: 8px; background: var(--fk-kafel-5-tlo); }
  .motyw-ksiezyc { width: 10px; height: 10px; right: 8px; top: 8px; background: var(--fk-tekst-pomocniczy); opacity: 0.5; }
  .motyw-kciuk { width: 22px; height: 22px; left: 2px; top: 2px; background: var(--fk-tlo); transition: transform var(--fk-czas-szybki) var(--fk-krzywa-standard); }
  .motyw[aria-checked='true'] .motyw-kciuk { transform: translateX(24px); }

  .menu-przycisk {
    display: none; width: 44px; height: 44px; align-items: center; justify-content: center;
    border: 1px solid var(--fk-obrys-kontrolka); border-radius: var(--radius-control); background: var(--fk-tlo); color: var(--fk-tekst-naglowek);
  }
  .postep { height: 4px; background: var(--fk-obrys); }
  .postep-wypelnienie { height: 100%; background: var(--fk-grad-przelamanie); transform-origin: 0 50%; transform: scaleX(0); }

  @media (max-width: 1023.98px) {
    .pasek-wnetrze { height: 61px; gap: 12px; }
    :global(html.js) .pasek-linki { display: none; }
    :global(html:not(.js)) .pasek-wnetrze { flex-wrap: wrap; height: auto; padding-block: 8px; }
    :global(html:not(.js)) .pasek-linki { order: 3; flex-basis: 100%; justify-content: flex-start; }
    :global(html:not(.js)) .grupy { flex-wrap: wrap; gap: 4px 8px; }
    :global(html.js) .menu-przycisk { display: inline-flex; }
    .motyw { display: none; }
    .pasek-cta { min-height: 44px; padding: 10px 16px; }
  }
  @media (max-width: 380px) { .pasek-cta { display: none; } }
  :global(html:not(.js)) .tylko-js { display: none !important; }

  .menu-mobilne {
    width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0 16px 24px;
    border: 0; background: var(--fk-tlo); color: var(--fk-tekst);
  }
  .menu-mobilne[open] { display: flex; flex-direction: column; gap: 24px; }
  .menu-mobilne::backdrop { background: rgb(14 17 23 / var(--fk-krycie-zaslona)); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.bez-ruchu)) .menu-mobilne[open] { animation: menu-wjazd var(--fk-czas-szybki) var(--fk-krzywa-wejscie); }
  }
  @keyframes menu-wjazd { from { transform: translateY(-16px); opacity: 0; } }
  .menu-gora {
    display: flex; align-items: center; justify-content: space-between; padding: 8px 20px; min-height: 61px;
    background: var(--fk-tlo-powierzchnia); border-bottom: 1px solid var(--fk-obrys); margin-inline: -16px;
  }
  .menu-gora .menu-przycisk { display: inline-flex; }
  .menu-lista { padding-top: 8px; }
  .menu-grupa { border-bottom: 1px solid var(--fk-obrys); }
  .menu-grupa summary { display: flex; justify-content: space-between; align-items: center; padding: 16px 4px; cursor: pointer; list-style: none; }
  .menu-link { display: block; padding: 16px 4px; color: inherit; text-decoration: none; }
  .menu-grupa summary::-webkit-details-marker { display: none; }
  .menu-grupa[open] summary span:last-child { transform: rotate(45deg); }
  .menu-podlista { display: grid; gap: 4px; padding: 0 4px 12px; }
  .menu-podlista a { display: grid; gap: 2px; padding: 10px 12px; border-radius: var(--radius-12); background: var(--fk-tlo-powierzchnia); text-decoration: none; color: inherit; }
  .menu-grupa .panel-notka { border: 0; padding: 0 8px 14px; }
</style>
