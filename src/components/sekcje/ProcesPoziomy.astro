---
// Proces na osi poziomej (28 S13 wariant D): sześć węzłów jako zakładki (role=tablist), pod nimi panel „My robimy / Ty robisz / Ty dostajesz”.
// Paginacja „← Wstecz · 01 / 06 · Dalej →” (data-kroki w strona.ts); przejście na kolejny etap zmienia poprzednie węzły na zielone ✓.
// Bez JS: zakładki i paginacja ukryte, wszystkie etapy widać jeden pod drugim. Telefon: same węzły (bez podpisów), panel pod nimi.
interface Etap { tytul: string; my_robimy: string; ty_robisz: string; ty_dostajesz: string }
interface Props { t: { naglowek: string; etapy: readonly Etap[] }; nr: string; id?: string }
const { t, nr, id = 'proces' } = Astro.props;
const p = nr.toLowerCase();
const n = t.etapy.length;
const dwa = (i: number) => String(i).padStart(2, '0');
---
<section class="proces baza segment" id={id} data-segment={`${nr} Proces`} aria-labelledby={`${p}-h`}>
  <div class="kontener proces-wnetrze" data-kroki>
    <h2 id={`${p}-h`} class="t-h2 naglowkowy">{t.naglowek}</h2>
    <div class="os" role="tablist" aria-label="Etapy współpracy" hidden>
      {t.etapy.map((e, i) => (
        <button type="button" role="tab" id={`${p}-z-${i}`} aria-controls={`${p}-e-${i}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>
          <span class="wezel t-etykieta" aria-hidden="true">{dwa(i + 1)}</span>
          <span class="podpis t-przycisk">{e.tytul}</span>
        </button>
      ))}
    </div>
    {t.etapy.map((e, i) => (
      <div class="etap" role="tabpanel" id={`${p}-e-${i}`} aria-labelledby={`${p}-z-${i}`} tabindex="0">
        <h3 class="t-h3 naglowkowy"><span class="akcentowy">{dwa(i + 1)}</span> {e.tytul}</h3>
        <dl class="role">
          <div><dt class="t-etykieta pomocniczy">My robimy</dt><dd class="t-tresc-l">{e.my_robimy}</dd></div>
          <div><dt class="t-etykieta pomocniczy">Ty robisz</dt><dd class="t-tresc-l">{e.ty_robisz}</dd></div>
          <div><dt class="t-etykieta pomocniczy">Ty dostajesz</dt><dd class="t-tresc-l">{e.ty_dostajesz}</dd></div>
        </dl>
      </div>
    ))}
    <div class="paginacja" hidden>
      <button type="button" class="t-etykieta wstecz" data-krok="-1">← Wstecz</button>
      <span class="t-etykieta naglowkowy" data-kroki-licznik aria-live="polite">01 / {dwa(n)}</span>
      <button type="button" class="t-etykieta dalej" data-krok="1">Dalej →</button>
    </div>
  </div>
</section>

<style>
  .proces { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .proces-wnetrze { display: grid; gap: 32px; }
  .os { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); position: relative; }
  .os[hidden] { display: none; }
  .os::before { content: ''; position: absolute; top: 24px; left: calc(100% / 12); right: calc(100% / 12); height: 2px; background: var(--fk-obrys-kontrolka); }
  .os button { position: relative; display: grid; justify-items: center; gap: 12px; padding: 0 4px; background: none; border: 0; cursor: pointer; color: var(--fk-tekst-pomocniczy); font: inherit; }
  .wezel { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--fk-tlo); border: 2px solid var(--fk-obrys-kontrolka); transition: background-color var(--fk-czas-szybki), color var(--fk-czas-szybki); }
  .os [aria-selected='true'] { color: var(--fk-tekst-naglowek); }
  .os [aria-selected='true'] .wezel, .os .przeszly .wezel { background: var(--fk-kafel-1-tlo); color: var(--fk-kafel-1-tekst); border-color: var(--fk-kafel-1-obrys); }
  .os .przeszly .wezel { font-size: 0; }
  .os .przeszly .wezel::after { content: '✓'; font-size: 18px; }
  .os button:hover .wezel { border-color: var(--fk-akcent); }
  .etap { display: grid; gap: 20px; padding: 28px 32px; border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); }
  .etap[hidden] { display: none; }
  .role { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .role div { display: grid; gap: 8px; align-content: start; }
  .paginacja { display: flex; align-items: center; gap: 16px; justify-self: start; }
  .paginacja[hidden] { display: none; }
  .paginacja button { padding: 8px 16px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: none; color: var(--fk-tekst-pomocniczy); cursor: pointer; }
  .paginacja .dalej { background: var(--fk-kafel-1-tlo); color: var(--fk-kafel-1-tekst); border-color: var(--fk-kafel-1-obrys); }
  .paginacja button:disabled { opacity: 0.45; cursor: default; }
  @media (prefers-reduced-motion: reduce) { .wezel { transition: none; } }
  @media (max-width: 1023.98px) {
    .podpis { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .wezel { width: 40px; height: 40px; }
    .os::before { top: 20px; }
    .etap { padding: 24px 20px; }
    .role { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .paginacja { justify-self: stretch; justify-content: space-between; }
  }
</style>
