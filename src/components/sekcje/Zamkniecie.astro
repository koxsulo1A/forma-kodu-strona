---
// Zamknięcie (28 S17 wariant C i kolejne strony): duże pytanie po lewej, karta z punktami i przyciskiem po prawej.
// Przycisk otwiera sheet „Opisz projekt” (bez JS prowadzi do /kontakt).
import Ikona from '../wspolne/Ikona.astro';
interface Props { t: { naglowek: string; punkty?: readonly string[]; cta: string; podpis?: string }; nr: string }
const { t, nr } = Astro.props;
const id = `${nr.toLowerCase()}-zamkniecie`;
---
<section class="zamkniecie baza segment" id="zamkniecie" data-segment={`${nr} Zamknięcie`} aria-labelledby={`${id}-h`}>
  <div class="kontener zamkniecie-wnetrze">
    <h2 id={`${id}-h`} class="t-display naglowkowy">{t.naglowek}</h2>
    <div class="karta">
      {t.punkty && t.punkty.length > 0 && (
        <ul role="list" class="punkty">
          {t.punkty.map((p) => <li><span class="znak" aria-hidden="true"><Ikona nazwa="check" rozmiar={20} /></span><span class="t-h4 naglowkowy">{p}</span></li>)}
        </ul>
      )}
      <a class="przycisk przycisk--akcent" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">{t.cta}</a>
      {t.podpis && <p class="t-maly pomocniczy">{t.podpis}</p>}
    </div>
  </div>
</section>

<style>
  .zamkniecie { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .zamkniecie-wnetrze { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; align-items: center; }
  .karta { display: grid; gap: 20px; justify-items: start; padding: 32px; border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); }
  .punkty { display: grid; gap: 16px; }
  .punkty li { display: flex; gap: 12px; align-items: center; }
  .znak { color: var(--fk-sukces); display: inline-flex; }
  @media (max-width: 1023.98px) {
    .zamkniecie-wnetrze { grid-template-columns: minmax(0, 1fr); gap: 28px; text-align: center; }
    .karta { justify-items: stretch; }
    .karta .przycisk { justify-content: center; }
  }
</style>
