---
// 29 S7 Cena (Figma 234:468): biała baza W2, cztery karty jako wycięcia (przez nie widać kratkę W1), cena w bloku na dole karty.
// Ceny z jednego cennika (kolekcja „Ceny”, relacja w panelu); puste = „Zakres i cenę ustalamy po rozmowie” (blok z przerywaną ramką).
// Kacper 25.11 16:06: segment interaktywny jak cennik na stronie głównej: klik w kartę otwiera „Opisz projekt” z wpisanym zakresem.
// Bez przypisu „kwoty od z naszego cennika”. Telefon: jedna karta swipe ze wskaźnikiem od 01.
import { cena, cenaTekst } from '../../lib/ceny.mjs';
interface Props { t: any }
const { t } = Astro.props;
const karty = t.zakresy.map((z: any, i: number) => {
  const c = cena(z.cena);
  return { ...z, nr: String(i + 1).padStart(2, '0'), tekst: c ? cenaTekst(c) : 'Zakres i cenę ustalamy po rozmowie', ma: !!c };
});
---
<section class="s7 baza segment" id="cena" data-segment="S7 Cena" aria-labelledby="s7-h">
  <div class="kontener s7-wnetrze">
    <header class="naglowek">
      <h2 id="s7-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l">{t.lead}</p>}
    </header>
    <ul role="list" class="karty swipe" data-swipe="s7-wskaznik">
      {karty.map((k: any) => (
        <li class="karta w1 wyciecie">
          <span class="nr t-etykieta" aria-hidden="true">{k.nr}</span>
          <h3 class="t-h4 naglowkowy">
            <a href="/kontakt" data-otworz-sheet="sheet-projekt" data-opis={`Pytam o zakres: ${k.nazwa}.`} aria-haspopup="dialog">{k.nazwa}</a>
          </h3>
          <p class="t-tresc">{k.opis}</p>
          <div class:list={['cena', { pusta: !k.ma }]}>
            <span class:list={[k.ma ? 't-h4' : 't-tresc', 'naglowkowy']}>{k.tekst}</span>
            <span class="dalej t-maly" aria-hidden="true">Opisz projekt <span class="strzalka">→</span></span>
          </div>
        </li>
      ))}
    </ul>
    <div class="wskaznik-swipe" id="s7-wskaznik" aria-hidden="true">
      <ol>{karty.map((_: any, i: number) => <li aria-current={String(i === 0)}></li>)}</ol>
      <span data-licznik>1 z {karty.length}</span>
    </div>
    {t.przypisy.length > 0 && <div class="przypisy">{t.przypisy.map((p: string) => <p class="t-maly pomocniczy">{p}</p>)}</div>}
  </div>
</section>

<style>
  .s7 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s7-wnetrze { display: grid; gap: 40px; }
  .naglowek { display: grid; gap: 12px; max-width: 880px; }
  .karty { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 21px; }
  .karta {
    position: relative; display: flex; flex-direction: column; gap: 16px; min-height: 462px; padding: 28px 28px 24px;
    transition: transform var(--fk-czas-szybki) var(--fk-krzywa-standard), box-shadow var(--fk-czas-szybki) var(--fk-krzywa-standard);
  }
  .nr { color: var(--fk-akcent); }
  .karta h3 { margin-top: -4px; }
  .karta a { color: inherit; text-decoration: none; }
  /* Cała karta klikalna: link w nagłówku rozciągnięty na kartę (czytnik ekranu czyta jeden link z nazwą zakresu). */
  .karta a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .karta a:focus-visible { outline: none; }
  .karta:focus-within { outline: 3px solid var(--fk-fokus); outline-offset: 3px; }
  .cena { margin-top: auto; display: grid; gap: 8px; padding: 20px; border-radius: 12px; background: var(--fk-tlo-podniesione); border: 1.5px solid transparent; }
  .cena.pusta { background: transparent; border: 1.5px dashed var(--fk-obrys-kontrolka); }
  .dalej { display: inline-flex; align-items: center; gap: 6px; color: var(--fk-akcent); font-weight: 600; }
  .strzalka { transition: transform var(--fk-czas-szybki) var(--fk-krzywa-standard); }
  .karta:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgb(14 17 23 / 0.10); }
  .karta:hover .cena { border-color: var(--fk-akcent); }
  .karta:hover .strzalka { transform: translateX(4px); }
  .przypisy { display: grid; gap: 4px; }
  @media (prefers-reduced-motion: reduce) { .karta, .karta:hover, .strzalka { transform: none !important; transition: none; } }
  @media (max-width: 1023.98px) { .karta { min-height: 0; padding: 24px 20px; } }
</style>
