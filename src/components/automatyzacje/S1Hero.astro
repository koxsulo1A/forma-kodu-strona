---
// 29 S1 Hero: pytanie klienta, dwa przyciski; po prawej okna, które zmieniają się przewinięciem w dół (Figma 617:1775, Kacper 25.11 16:06):
// czat z botem (klikalny, stała wysokość, nowe wiadomości przewijają się w środku) → diagram automatyzacji → automatyczny recepcjonista.
// Bez oznaczeń „przykład” i bez etykiet atutów nad H1 (Kacper 25.11). Zachowanie: data-czat-demo (9d) i data-okna (9g) w strona.ts.
// Bez JS albo bez ruchu: okna jedno pod drugim.
interface Props { t: any }
const { t } = Astro.props;
const kroki = [
  ['Wyzwalacz', 'Klient wysyła formularz na stronie'],
  ['Krok 1', 'Zapis w arkuszu zapytań'],
  ['Krok 2', 'Powiadomienie na Twój telefon'],
  ['Krok 3', 'E-mail do klienta: „Dostaliśmy, odezwiemy się”'],
];
const pola = [['Usługa', 'Trening personalny'], ['Termin', 'wtorek i czwartek, 11:00–12:00'], ['Telefon', 'podany'], ['E-mail', 'podany']];
---
<section class="s1 baza segment" id="start" data-segment="S1 Hero" aria-labelledby="s1-h">
  <div class="kontener s1-wnetrze">
    <div class="tekst">
      <h1 id="s1-h" class="t-display naglowkowy">{t.h1}</h1>
      <p class="t-tresc-l">{t.lead}</p>
      <div class="akcje">
        <a class="przycisk przycisk--glowny" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">{t.cta_1}</a>
        {t.cta_2 && <a class="przycisk przycisk--drugi" href="#jak-pracujemy">{t.cta_2}</a>}
      </div>
    </div>
    <div class="okna-blok">
    <div class="okna" data-okna>
      <div class="okna-tor" data-okna-tor>
        <figure class="okno" data-okno data-czat-demo aria-labelledby="s1-czat-h">
          <figcaption class="okno-gora"><span id="s1-czat-h" class="tytul naglowkowy">Asystent na stronie</span><span class="t-etykieta etykieta">odpowiada od razu</span></figcaption>
          <ol role="list" class="wiadomosci" aria-live="polite" data-czat-wiadomosci>
            <li class="dymek klient"><small>Klient</small>Witam, czy można umówić się na trening personalny?</li>
            <li class="dymek asystent"><small>Asystent</small>Tak, ile dni w tygodniu?</li>
          </ol>
          <div class="odpowiedzi" data-czat-odpowiedzi>
            <button type="button" data-czat="dni">1 dzień</button>
            <button type="button" data-czat="dni">2 dni</button>
            <button type="button" data-czat="dni">3 dni</button>
            <button type="button" data-czat="dni">4 dni lub więcej</button>
          </div>
        </figure>
        <figure class="okno" data-okno aria-labelledby="s1-diagram-h">
          <figcaption class="okno-gora"><span id="s1-diagram-h" class="tytul naglowkowy">Diagram automatyzacji</span><span class="t-etykieta etykieta">zapytanie z formularza</span></figcaption>
          <ol role="list" class="przeplyw">
            {kroki.map(([e, s], i) => (
              <li class:list={['wezel', { start: i === 0 }]}>
                <span class="nr t-etykieta" aria-hidden="true">{i === 0 ? '▶' : i}</span>
                <span class="opis"><span class="t-etykieta">{e}</span><span>{s}</span></span>
              </li>
            ))}
          </ol>
          <p class="t-etykieta pomocniczy stopka-okna">Każdy krok zapisuje się w historii, więc wiesz, co zrobiła automatyzacja.</p>
        </figure>
        <figure class="okno" data-okno aria-labelledby="s1-rec-h">
          <figcaption class="okno-gora"><span id="s1-rec-h" class="tytul naglowkowy">Automatyczny recepcjonista</span><span class="t-etykieta etykieta">nowe zgłoszenie</span></figcaption>
          <dl class="zgloszenie">
            {pola.map(([k, v]) => <div><dt class="t-etykieta pomocniczy">{k}</dt><dd>{v}</dd></div>)}
          </dl>
          <p class="statusy"><span class="t-etykieta ok">✓ Dane kompletne</span><span class="t-etykieta dalej">→ Przekazano do kalendarza</span></p>
          <p class="wyjatek">Nietypowa prośba? Recepcjonista nie decyduje sam: zgłoszenie trafia do Ciebie.</p>
        </figure>
      </div>
    </div>
    <!-- Kacper 25.11 17:36: mały przycisk do przełączania okien (poprzednie / następne). Widoczny tylko, gdy działa karuzela. -->
    <div class="sterowanie" data-okna-sterowanie hidden>
      <button type="button" class="strzalka" data-okna-krok="-1" aria-label="Poprzednie okno"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 12V4M4 8l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <span class="t-etykieta licznik" data-okna-licznik aria-live="polite">1 / 3</span>
      <button type="button" class="strzalka" data-okna-krok="1" aria-label="Następne okno"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 4v8M4 8l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    </div>
  </div>
</section>

<style>
  .s1 { padding-block: clamp(24px, 3.5vw, 51px) 38px; }
  .s1-wnetrze { display: grid; grid-template-columns: minmax(0, 718fr) minmax(0, 542fr); gap: 52px; align-items: center; }
  .tekst { display: grid; gap: 24px; }
  .akcje { display: flex; flex-wrap: wrap; gap: 16px; }
  /* Okna: stała wysokość 460 px; w karuzeli widać jedno, tor przesuwa się w górę o jedno okno. */
  .okna-blok { display: grid; gap: 12px; }
  .sterowanie { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
  .sterowanie[hidden] { display: none; }
  .strzalka { width: 36px; height: 36px; display: grid; place-items: center; padding: 0; border-radius: 50%; border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo); color: var(--fk-tekst-naglowek); cursor: pointer; transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease; }
  .strzalka:hover { background: var(--fk-akcent); border-color: var(--fk-akcent); color: var(--fk-tekst-na-akcencie); }
  .strzalka:focus-visible { outline: 3px solid var(--fk-fokus); outline-offset: 2px; }
  .licznik { min-width: 44px; text-align: center; color: var(--fk-tekst-pomocniczy); }
  .okna { --wys-okna: 460px; }
  .okna-tor { display: grid; gap: 24px; }
  .okna.karuzela { height: var(--wys-okna); overflow: hidden; border-radius: 16px; }
  .okna.karuzela .okna-tor { will-change: transform; }
  .okno { margin: 0; min-height: var(--wys-okna); display: flex; flex-direction: column; gap: 16px; padding: 28px; border-radius: 16px; background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); overflow: hidden; }
  /* Czat zawsze ma stałą wysokość (nowe wiadomości przewijają się w środku); pozostałe okna tylko w karuzeli, bez niej rosną z treścią. */
  .okno[data-czat-demo], .okna.karuzela .okno { height: var(--wys-okna); }
  .okno-gora { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; flex: none; }
  .tytul { font-size: 22px; font-weight: 600; line-height: 1.3; }
  .etykieta { padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); color: var(--fk-tekst); }
  .wiadomosci { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; overscroll-behavior: contain; scrollbar-width: thin; padding-right: 4px; }
  .wiadomosci > :first-child { margin-top: auto; }
  .dymek { display: grid; gap: 4px; max-width: 86%; padding: 12px 16px; border-radius: 12px; font-size: var(--fk-font-tresc); line-height: 1.5; flex: none; }
  .dymek small { font-family: var(--fk-rodzina-mono); font-size: 12px; opacity: 0.8; }
  .klient { align-self: flex-start; background: var(--fk-tlo-podniesione); color: var(--fk-tekst-naglowek); }
  .asystent { align-self: flex-end; background: var(--fk-przelamanie); color: var(--fk-przelamanie-tekst); }
  :global(html:not(.bez-ruchu)) .dymek.nowy { animation: wejdz var(--fk-czas-rozwiniecie) var(--fk-krzywa-wejscie); }
  @keyframes wejdz { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .dymek.nowy { animation: none !important; } }
  .odpowiedzi { display: flex; flex-wrap: wrap; gap: 8px; flex: none; }
  :global(html:not(.js)) .odpowiedzi { display: none; }
  .odpowiedzi button { padding: 8px 14px; border-radius: var(--radius-pill); border: 1px solid var(--fk-akcent); background: var(--fk-tlo); color: var(--fk-akcent); font: inherit; font-size: var(--fk-font-maly); cursor: pointer; }
  .odpowiedzi button:hover { background: var(--fk-akcent); color: var(--fk-tekst-na-akcencie); }
  .odpowiedzi .od-nowa { border-color: var(--fk-obrys-kontrolka); color: var(--fk-tekst); }
  /* Diagram */
  .przeplyw { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; position: relative; }
  .przeplyw::before { content: ''; position: absolute; left: 30px; top: 24px; bottom: 24px; width: 2px; background: var(--fk-obrys-kontrolka); }
  .wezel { position: relative; display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 12px; background: var(--fk-tlo); border: 1px solid var(--fk-obrys); color: var(--fk-tekst-naglowek); }
  .wezel.start { background: var(--fk-przelamanie); border-color: var(--fk-przelamanie); color: var(--fk-przelamanie-tekst); }
  .nr { flex: none; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--fk-kafel-1-tlo); color: var(--fk-kafel-1-tekst); }
  .start .nr { background: var(--fk-przelamanie-tekst); color: var(--fk-przelamanie); }
  .opis { display: grid; gap: 2px; font-size: 16px; line-height: 1.35; }
  .opis .t-etykieta { opacity: 0.75; }
  .stopka-okna { margin-top: auto; }
  /* Recepcjonista */
  .zgloszenie { display: grid; gap: 10px; margin: 0; padding: 16px 20px; border-radius: 12px; background: var(--fk-tlo); border: 1px solid var(--fk-obrys); }
  .zgloszenie div { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 12px; align-items: center; }
  .zgloszenie dd { margin: 0; color: var(--fk-tekst-naglowek); }
  .statusy { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .statusy span { padding: 6px 12px; border-radius: var(--radius-pill); }
  .ok { background: var(--fk-kafel-1-tlo); color: var(--fk-kafel-1-tekst); }
  .dalej { background: var(--fk-przelamanie); color: var(--fk-przelamanie-tekst); }
  .wyjatek { margin: 0; padding: 12px 16px; border-radius: 12px; border: 1px solid var(--fk-obrys-kontrolka); font-size: 15px; line-height: 1.45; }
  @media (max-width: 1023.98px) {
    .s1-wnetrze { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .akcje .przycisk { flex: 1; justify-content: center; }
    .okna { --wys-okna: 540px; }
    .okno { padding: 20px; }
  }
</style>
