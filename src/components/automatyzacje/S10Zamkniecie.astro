---
// 29 S10 Zamknięcie (wariant D): pytanie jako dymek przychodzącej wiadomości, przycisk jak odpowiedź (echo rozmowy z hero), pod nim etykiety atutów.
// Animacja „przychodząca wiadomość ×2”: dymek i przycisk wjeżdżają po kolei przy wejściu w ekran ([data-odslon]).
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s10 baza segment" id="zamkniecie" data-segment="S10 Zamknięcie" aria-labelledby="s10-h">
  <div class="kontener-waski s10-wnetrze" data-odslon>
    <div class="dymek"><small class="t-etykieta">Forma Kodu</small><h2 id="s10-h" class="t-h2 naglowkowy">{t.naglowek}</h2></div>
    <div class="odpowiedz"><a class="przycisk przycisk--akcent" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">{t.cta}</a></div>
    {t.atuty.length > 0 && <ul role="list" class="atuty">{t.atuty.map((a: string) => <li class="t-etykieta">{a}</li>)}</ul>}
  </div>
</section>

<style>
  .s10 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s10-wnetrze { display: grid; gap: 20px; }
  .dymek { justify-self: start; max-width: 820px; display: grid; gap: 8px; padding: 28px 32px; border-radius: 24px 24px 24px 6px; background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); }
  .dymek small { color: var(--fk-tekst-pomocniczy); }
  .odpowiedz { justify-self: end; }
  .atuty { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  .atuty li { padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-sukces); color: var(--fk-sukces); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.bez-ruchu)) .s10-wnetrze:not(.widoczny) :is(.dymek, .odpowiedz) { opacity: 0; transform: translateY(12px); }
    :global(html.js:not(.bez-ruchu)) :is(.dymek, .odpowiedz) { transition: opacity var(--fk-czas-odslona) var(--fk-krzywa-wejscie), transform var(--fk-czas-odslona) var(--fk-krzywa-wejscie); }
    .odpowiedz { transition-delay: 400ms; }
  }
  @media (max-width: 1023.98px) {
    .dymek { padding: 20px; }
    .odpowiedz, .odpowiedz .przycisk { justify-self: stretch; width: 100%; justify-content: center; }
    .atuty { justify-content: flex-start; }
  }
</style>
