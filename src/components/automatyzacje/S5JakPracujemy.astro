---
// 29 S5 Jak pracujemy (wariant E, Figma 228:470): nagłówek po lewej przy górnej krawędzi, po prawej cztery karty nachodzące
// na siebie po skosie (01 na górze z lewej, 04 na dole z prawej), tła na przemian jasne i szare, małe numery w mono.
// Kacper 25.11 16:06 i 17:31: gdy nagłówek wejdzie w ekran, sama rusza powolna animacja jak 27 S7: karty po kolei wjeżdżają
// od dołu i kładą się na poprzednią (1000 ms każda, co 700 ms). Klasa .widoczny z obserwatora [data-odslon] (strona.ts 9e).
// data-ruch-wlasny: segment poza ogólną kaskadą (ruch.ts), bo jej szybkie odsłanianie nadpisywało tę animację.
// Telefon: karty jedna pod drugą, bez przesunięcia.
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s5 baza segment" id="jak-pracujemy" data-segment="S5 Jak pracujemy" aria-labelledby="s5-h" data-ruch-wlasny>
  <div class="kontener s5-wnetrze">
    <header class="naglowek" data-odslon>
      <h2 id="s5-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l pomocniczy">{t.lead}</p>}
    </header>
    <ol role="list" class="stos">
      {t.kroki.map((k: any, i: number) => (
        <li class="karta" data-n={i + 1}>
          <h3 class="tytul naglowkowy"><span class="t-etykieta akcentowy nr">{String(i + 1).padStart(2, '0')}</span>{k.tytul}</h3>
          <p class="t-tresc">{k.opis}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* overflow-x: clip: karty wjeżdżają z boku (ruch.ts); bez tego przy 1024–1280 px strona przewijała się w bok (test 28.11) */
  .s5 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); overflow-x: clip; }
  .s5-wnetrze { display: grid; grid-template-columns: minmax(0, 440fr) minmax(0, 780fr); gap: 92px; align-items: start; }
  .naglowek { display: grid; gap: 12px; }
  .stos { display: grid; }
  .karta { position: relative; display: grid; gap: 12px; width: min(100%, 600px); padding: 24px 28px 40px; border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); box-shadow: 0 1px 2px rgb(16 24 40 / 0.04), 0 8px 24px rgb(14 17 23 / 0.06); }
  .karta:nth-child(even) { background: var(--fk-tlo-podniesione); }
  .karta + .karta { margin-top: -30px; }
  .karta[data-n='2'] { margin-left: 56px; z-index: 2; }
  .karta[data-n='3'] { margin-left: 112px; z-index: 3; }
  .karta[data-n='4'] { margin-left: 168px; z-index: 4; }
  .tytul { display: flex; align-items: baseline; gap: 14px; font-size: 20px; font-weight: 600; line-height: 1.3; }
  .nr { flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.bez-ruchu)) .naglowek:not(.widoczny) + .stos .karta { opacity: 0; transform: translate3d(0, 160px, 0); }
    :global(html.js:not(.bez-ruchu)) .karta { transition: opacity 700ms var(--fk-krzywa-wejscie), transform 1000ms cubic-bezier(0.22, 1, 0.36, 1); }
    :global(html.js:not(.bez-ruchu)) .karta[data-n='1'] { transition-delay: 150ms; }
    :global(html.js:not(.bez-ruchu)) .karta[data-n='2'] { transition-delay: 850ms; }
    :global(html.js:not(.bez-ruchu)) .karta[data-n='3'] { transition-delay: 1550ms; }
    :global(html.js:not(.bez-ruchu)) .karta[data-n='4'] { transition-delay: 2250ms; }
  }
  @media (max-width: 1023.98px) {
    .s5-wnetrze { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .karta, .karta[data-n] { margin-left: 0; width: 100%; padding: 20px; }
    .karta + .karta { margin-top: 12px; }
  }
</style>
