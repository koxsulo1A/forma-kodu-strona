---
// 29 S4 Co potrafią, a czego nie (wariant C): ciemny panel, nagłówek bloku po lewej, lista z plakietkami „Co potrafi” / „Czego nie potrafi” po prawej.
// Trzy bloki (bot, recepcjonista, automatyzacja procesu). Od 1024 px blok zmienia się przewijaniem jak w makiecie (ruch.ts, punkt 6), zakładki 1/3–3/3 pokazują, który jest aktywny.
// Bez JS wszystkie trzy bloki widać jeden pod drugim. Telefon: zakładki przewijane w poziomie, lista w jednej kolumnie.
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s4 baza segment" data-bloki-przewijane id="co-potrafia" data-segment="S4 Co potrafią" aria-labelledby="s4-h">
  <div class="kontener s4-wnetrze">
    <header class="naglowek">
      <h2 id="s4-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l pomocniczy">{t.lead}</p>}
    </header>
    <div class="zakladki" role="tablist" aria-label="Rodzaje rozwiązań" hidden>
      {t.bloki.map((b: any, i: number) => (
        <button type="button" role="tab" id={`s4-z-${i}`} aria-controls={`s4-b-${i}`} aria-selected={String(i === 0)} tabindex={i === 0 ? 0 : -1}>
          <span class="t-etykieta">{i + 1}/{t.bloki.length}</span><span class="t-przycisk">{b.nazwa}</span>
        </button>
      ))}
    </div>
    {t.bloki.map((b: any, i: number) => (
      <div class="panel" role="tabpanel" id={`s4-b-${i}`} aria-labelledby={`s4-z-${i}`} tabindex="0">
        <div class="panel-naglowek"><h3 class="t-h3">{b.tytul}</h3>{b.podtytul && <p class="t-tresc">{b.podtytul}</p>}</div>
        <ul role="list" class="lista">
          {b.potrafi.map((p: string) => <li><span class="t-etykieta plak tak">Co potrafi</span><span class="t-tresc-l">{p}</span></li>)}
          {b.nie_potrafi.map((p: string) => <li><span class="t-etykieta plak nie">Czego nie potrafi</span><span class="t-tresc-l">{p}</span></li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .s4 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s4-wnetrze { display: grid; gap: 24px; }
  .naglowek { display: grid; gap: 12px; max-width: 880px; }
  .zakladki { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .zakladki[hidden] { display: none; }
  .zakladki button { flex: none; display: inline-flex; align-items: baseline; gap: 10px; padding: 12px 20px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: none; color: var(--fk-tekst-pomocniczy); cursor: pointer; font: inherit; }
  .zakladki [aria-selected='true'] { background: var(--fk-grad-zakladka); color: var(--fk-tekst-na-akcencie); border-color: transparent; box-shadow: var(--fk-cien-zakladka); }
  .panel { display: grid; grid-template-columns: minmax(0, 364fr) minmax(0, 820fr); gap: 64px; padding: 48px; border-radius: var(--radius-card); background: var(--fk-grad-czern); color: var(--fk-panel-czern-tekst); }
  .panel[hidden] { display: none; }
  .panel + .panel { margin-top: 0; }
  .panel-naglowek { display: grid; gap: 12px; align-content: start; }
  .panel h3 { color: inherit; }
  .lista { display: grid; }
  .lista li { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--fk-panel-czern-polysk); }
  .plak { justify-self: start; padding: 4px 12px; border-radius: var(--radius-pill); }
  .tak { background: var(--fk-kafel-1-tlo); color: var(--fk-kafel-1-tekst); }
  .nie { background: var(--fk-akcent-na-ciemnym); color: var(--fk-akcent-na-ciemnym-tekst); }
  @media (max-width: 1023.98px) {
    .panel { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 24px 20px; }
    .lista li { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }
</style>
