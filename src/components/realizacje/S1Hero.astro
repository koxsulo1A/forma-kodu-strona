---
// 31 S1 Hero: tekst i 2 przyciski po lewej; po prawej karta wyróżnionego projektu (wybór w panelu) i blok „Realizacji klientów jeszcze nie ma”.
// Blok znika sam, gdy w kolekcji jest realizacja klienta ze statusem „gotowe”.
// Makieta: karta obraca się o 180° przy wejściu. Kod: karta wjeżdża łagodnie (bez obrotu: obrót utrudnia czytanie i jest ciężki dla osób wrażliwych na ruch).
interface Props { t: any; wyrozniony: any; slug: string | null; sakKlienta: boolean }
const { t, wyrozniony, slug, sakKlienta } = Astro.props;
const status = (e: any) => `${e.typ === 'klient' ? 'Projekt klienta' : e.typ === 'projekt własny' ? 'Projekt własny' : 'Przykład układu'} · ${e.status === 'w toku' ? 'w przygotowaniu' : 'zakończony'}`;
---
<section class="s1 baza segment" id="start" data-segment="S1 Hero" aria-labelledby="s1-h">
  <div class="kontener s1-wnetrze">
    <div class="tekst">
      <h1 id="s1-h" class="t-display naglowkowy">{t.h1}</h1>
      {t.lead && <p class="t-tresc-l">{t.lead}</p>}
      <p class="przyciski">
        <a class="przycisk przycisk--drugi" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">{t.cta_1}</a>
        {t.cta_2 && <a class="przycisk przycisk--drugi" href="/#proces">{t.cta_2}</a>}
      </p>
    </div>
    <div class="karty" data-odslon>
      {wyrozniony && (
        <article class="karta">
          <p class="t-etykieta pomocniczy">{wyrozniony.podkategoria || wyrozniony.kategoria}</p>
          <h2 class="t-h3 naglowkowy">{slug && wyrozniony.typ !== 'przykład układu' ? <a href={`/realizacje/${slug}`}>{wyrozniony.naglowek}</a> : wyrozniony.naglowek}</h2>
          <p class="t-maly">{wyrozniony.opis}</p>
          <p><span class="t-etykieta plak">{status(wyrozniony)}</span></p>
        </article>
      )}
      {!sakKlienta && t.brak_realizacji?.tytul && (
        <div class="brak">
          <p class="t-h4 naglowkowy">{t.brak_realizacji.tytul}</p>
          {t.brak_realizacji.opis && <p class="t-maly">{t.brak_realizacji.opis}</p>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .s1 { padding-block: clamp(24px, 3.5vw, 51px) clamp(40px, 5vw, 72px); }
  .s1-wnetrze { display: grid; grid-template-columns: minmax(0, 700fr) minmax(0, 548fr); gap: 64px; align-items: start; }
  .tekst { display: grid; gap: 20px; }
  .przyciski { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .karty { display: grid; gap: 16px; }
  .karta { position: relative; display: grid; gap: 8px; padding: 24px; border-radius: var(--radius-card); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys-kontrolka); }
  .karta a { color: inherit; text-decoration: none; }
  .karta a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .karta:focus-within { outline: 3px solid var(--fk-fokus); outline-offset: 3px; }
  .karta a:focus-visible { outline: none; }
  .plak { display: inline-block; padding: 4px 10px; border-radius: var(--radius-control); border: 1px solid var(--fk-tekst-naglowek); color: var(--fk-tekst-naglowek); }
  .brak { display: grid; gap: 6px; padding: 24px; border-radius: var(--radius-card); background: var(--fk-tlo-podniesione); border: 1px dashed var(--fk-akcent); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.bez-ruchu)) .karty > * { transition: opacity 500ms var(--fk-krzywa-wejscie), transform 500ms var(--fk-krzywa-wejscie); }
    :global(html.js:not(.bez-ruchu)) .karty:not(.widoczny) > * { opacity: 0; transform: translateY(16px); }
    .karty > :nth-child(2) { transition-delay: 150ms; }
  }
  @media (max-width: 1023.98px) {
    .s1-wnetrze { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .przyciski { flex-direction: column; }
    .przyciski .przycisk { width: 100%; justify-content: center; }
  }
</style>
