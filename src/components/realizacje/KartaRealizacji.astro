---
// Karta realizacji (31 S2, 31b S6; przyciski 31-4 i 31b-5). Wzór: karta z designsolutions.pl, wygląd z makiety 31.
// Kolejność: zdjęcie 2:1 → etykieta (podkategoria) → nagłówek → opis → tagi technologii → „Miasto · data” → plakietka typu i statusu → „Zobacz realizację →”.
// Cała karta klikalna przez JEDEN link na nagłówku rozciągnięty na kartę (::after), bez zagnieżdżonych linków.
// „Przykład układu” nie ma podstrony: karta bez linku, z przerywaną ramką i plakietką „Przykład: układ, nie realizacja” (zasada stała 12).
// data-vt łączy zdjęcie karty ze zdjęciem w hero podstrony 31b (View Transitions między stronami; nazwy w /przejscia-realizacji.css).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { okresRealizacji } from '../../lib/okres';
interface Props { r: CollectionEntry<'realizacje'>; poziom?: 'h2' | 'h3' }
const { r, poziom = 'h3' } = Astro.props;
const d = r.data;
const H = poziom;
const przyklad = d.typ === 'przykład układu';
const link = przyklad ? null : `/realizacje/${r.id}`;
// Zdjęcie zastępcze (miejsce-na-zrzut.png) → ramka z napisem jak w Figmie 226:243 („zrzut: jeszcze nie ma” / „przykład układu”).
const brakZdjecia = String(d.zdjecie_glowne?.src ?? '').includes('miejsce-na-zrzut');
// Wartości zastępcze z panelu w nawiasach („[RRRR-MM]”) nie trafiają na stronę.
const wypelnione = (x: string) => Boolean(x) && !/^\[.*\]$/.test(x.trim());
const miejsceData = [d.miasto ?? '', okresRealizacji(d)].filter(wypelnione).join(' · ');
const plakietka = przyklad
  ? 'Przykład: układ, nie realizacja'
  : `${d.typ === 'klient' ? 'Projekt klienta' : 'Projekt własny'} · ${d.status === 'w toku' ? 'w przygotowaniu' : 'zakończony'}`;
---
<article class:list={['karta-realizacji', { klikalna: link, przyklad }]}>
  {brakZdjecia
    ? <div class="zdjecie zastepcze" data-vt={link ? r.id : undefined}><p class="t-etykieta pomocniczy">{przyklad ? 'przykład układu' : 'zrzut: jeszcze nie ma'}</p></div>
    : <div class="zdjecie"><Image src={d.zdjecie_glowne} alt={d.zdjecie_alt} widths={[400, 800]} sizes="(min-width: 1024px) 25vw, 80vw" data-vt={link ? r.id : undefined} /></div>}
  <p class="t-etykieta pomocniczy">{d.podkategoria || d.kategoria}</p>
  <H class="tytul naglowkowy">{link ? <a href={link}>{d.naglowek}</a> : d.naglowek}</H>
  <p class="opis">{d.opis}</p>
  {d.technologie.length > 0 && <ul class="tagi" aria-label="Technologie">{d.technologie.map((t) => <li class="t-etykieta">{t}</li>)}</ul>}
  {miejsceData && <p class="t-etykieta pomocniczy">{miejsceData}</p>}
  <p><span class="t-etykieta plakietka">{plakietka}</span></p>
  {link && <p class="t-etykieta akcentowy wiecej" aria-hidden="true">Zobacz realizację →</p>}
</article>

<style>
  /* Wygląd 1:1 z Figmą 226:243: karta pad 20/18/24, promień 16, odstęp 12; tytuł 19 px regular, opis 14 px, etykiety mono 12 px. */
  .karta-realizacji { position: relative; height: 100%; display: flex; flex-direction: column; gap: 12px; padding: 20px 18px 24px; border-radius: 16px; background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys); transition: border-color var(--fk-czas-szybki), transform var(--fk-czas-szybki) var(--fk-krzywa-standard); }
  .karta-realizacji > * { margin: 0; }
  .karta-realizacji.klikalna:hover { border-color: var(--fk-obrys-kontrolka); }
  .przyklad { border: 1.5px dashed var(--fk-obrys-kontrolka); }
  .zdjecie { border-radius: 10px; overflow: hidden; background: var(--fk-tlo-podniesione); }
  .zdjecie img { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; }
  .zastepcze { aspect-ratio: 2 / 1; display: grid; place-items: center; border: 1px dashed var(--fk-obrys); }
  .zastepcze p { margin: 0; }
  .tytul { font-size: 19px; font-weight: 400; line-height: 1.55; }
  .opis { font-size: 14px; line-height: 1.5; color: var(--fk-tekst); }
  .klikalna a { color: inherit; text-decoration: none; }
  .klikalna a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; } /* cała karta = jeden link */
  .klikalna:focus-within { outline: 3px solid var(--fk-fokus); outline-offset: 3px; }
  .klikalna a:focus-visible { outline: none; }
  .tagi { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tagi li { padding: 3px 9px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys); color: var(--fk-tekst-pomocniczy); }
  .plakietka { display: inline-block; max-width: 100%; white-space: nowrap; font-size: 12px; padding: 5px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); color: var(--fk-tekst); }
  .wiecej { margin-top: auto; }
  @media (max-width: 1279.98px) { .plakietka { white-space: normal; } } /* 1024–1279 px: 4 kolumny, plakietka w jednej linii wychodziła poza kartę (test 28.11) */
</style>
