---
// 30 S3 Planowany zakres (Figma 239:254, wariant D): nagłówek po lewej; po prawej dwie ciemne karty schodkowo (wąska przy prawej krawędzi,
// pod nią szersza), pod spodem karta na całą szerokość (ostatni punkt). Karty: satyna #0e1117 z jaśniejszym pasem, plakietka „wkrótce” i link.
// Ruch (Figma 513:934, Kacper 25.11 16:06): segment przypięty, każdy odcinek przewijania wsuwa z lewej kolejną kartę (ruch.ts, krokiPrzypiete).
// Bez JS, przy „ogranicz ruch” i na telefonie: karty widać od razu, jedna pod drugą.
interface Props { t: any }
const { t } = Astro.props;
const n = t.punkty.length;
---
<section class="s3 baza segment" id="zakres" data-segment="S3 Planowany zakres" aria-labelledby="s3-h" data-kroki-przypiete data-ruch-wlasny>
  <div class="kontener s3-wnetrze">
    <header class="naglowek">
      <h2 id="s3-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      {t.lead && <p class="t-tresc-l">{t.lead}</p>}
    </header>
    <ul role="list" class="karty">
      {t.punkty.map((p: any, i: number) => (
        <li class:list={['karta', { szeroka: i === n - 1, waska: i === 0 && n > 2 }]} data-krok={i + 1}>
          <h3 class="tytul">{p.tytul}</h3>
          <p class="opis">{p.opis}</p>
          <p class="dol"><span class="t-etykieta plak">wkrótce</span><a class="link" href="#mierzymy">Zobacz zakres<span class="sr-only">: {p.tytul}</span></a></p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .s3 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s3-wnetrze { display: grid; gap: 24px; }
  .naglowek { display: grid; gap: 12px; align-content: start; max-width: 440px; }
  .naglowek > * { margin: 0; }
  .karty { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .karta {
    display: grid; gap: 12px; align-content: start; padding: 28px 32px 32px; border-radius: 16px;
    background: linear-gradient(112deg, #0e1117 0%, #262c38 50%, #0e1117 100%); color: #f1f4f9;
  }
  .karta > * { margin: 0; }
  .tytul { font-size: 22px; font-weight: 600; line-height: 1.3; color: inherit; }
  .opis { font-size: 17px; line-height: 1.55; }
  .dol { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .plak { padding: 5px 12px; border-radius: var(--radius-pill); border: 1px solid #dce4ff; color: #f1f4f9; }
  .link { position: relative; font-size: var(--fk-font-maly); color: #f1f4f9; text-decoration: underline; text-underline-offset: 3px; min-height: 44px; display: inline-flex; align-items: center; }
  .link:hover { color: #dce4ff; }
  .link:focus-visible { outline: 3px solid var(--fk-fokus); outline-offset: 2px; border-radius: 4px; }

  /* Komputer: lewa kolumna 440 z nagłówkiem, prawa 800 ze schodami; ostatnia karta na całą szerokość pod spodem. */
  @media (min-width: 1024px) {
    .s3-wnetrze { grid-template-columns: minmax(0, 440fr) minmax(0, 800fr); column-gap: 72px; row-gap: 0; }
    .naglowek { grid-area: 1 / 1; }
    .karty { grid-area: 1 / 1 / auto / -1; grid-template-columns: subgrid; column-gap: 72px; }
    .karta { grid-column: 2; }
    .karta.waska { justify-self: end; width: 65%; }
    .karta.szeroka { grid-column: 1 / -1; margin-top: 8px; }
  }
  /* Ruch: karta czeka poza ekranem po lewej, wsuwa się 500 ms (ease-out). Klasa „czeka” tylko z JS (ruch.ts). */
  .karta { transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1), transform 500ms cubic-bezier(0.16, 1, 0.3, 1); }
  .karta:global(.czeka) { opacity: 0; transform: translate3d(-160px, 0, 0); pointer-events: none; }
  @media (max-width: 1023.98px) {
    .karta { padding: 24px 20px; }
  }
</style>
