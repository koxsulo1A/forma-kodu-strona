---
// 30 S5 Czego nie obiecamy (Figma 239:287, wariant C, statyczny): wszystko wyśrodkowane, nadtytuł, pytanie 64 px, pigułki 2×2 z czerwonym ✗, podpis.
// Telefon: pigułki jedna pod drugą.
import Ikona from '../wspolne/Ikona.astro';
interface Props { t: any }
const { t } = Astro.props;
---
<section class="s5 baza segment" id="nie-obiecamy" data-segment="S5 Czego nie obiecamy" aria-labelledby="s5-h">
  <div class="kontener s5-wnetrze">
    {t.etykieta && <p class="t-etykieta pomocniczy">{t.etykieta}</p>}
    <h2 id="s5-h" class="t-h2 naglowkowy cytat">{t.naglowek}</h2>
    <p class="sr-only">Nie obiecujemy:</p>
    <ul role="list" class="pigulki">
      {t.punkty.map((p: string) => (
        <li><span class="x" aria-hidden="true"><Ikona nazwa="zamknij" rozmiar={18} /></span>{p}</li>
      ))}
    </ul>
    {t.podpis && <p class="podpis">{t.podpis}</p>}
  </div>
</section>

<style>
  .s5 { padding-block: clamp(48px, 5vw, 70px) clamp(40px, 4vw, 53px); }
  .s5-wnetrze { display: grid; gap: 28px; justify-items: center; text-align: center; }
  .s5-wnetrze > * { margin: 0; }
  .cytat { max-width: 1000px; font-size: clamp(36px, 4.45vw, 64px); line-height: 1.05; letter-spacing: -0.01em; font-weight: 700; }
  .pigulki { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 1000px; }
  .pigulki li { display: inline-flex; align-items: center; gap: 10px; padding: 12px 20px 12px 16px; border-radius: var(--radius-pill); background: var(--fk-tlo-powierzchnia); border: 1px solid var(--fk-obrys-kontrolka); color: var(--fk-tekst-naglowek); font-size: 17px; line-height: 1.55; text-align: left; }
  .x { flex: none; display: grid; place-items: center; width: 18px; height: 18px; color: var(--fk-blad); }
  .podpis { max-width: 720px; font-size: 17px; line-height: 1.55; color: var(--fk-tekst); }
  @media (max-width: 1023.98px) {
    .s5-wnetrze { gap: 20px; }
    .pigulki { flex-direction: column; align-items: stretch; width: 100%; }
    .pigulki li { font-size: 16px; }
  }
</style>
