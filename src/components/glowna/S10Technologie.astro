---
// 27 S10 Technologie: trzy kolumny, w każdej stos kart warstw (animacja „rozłożenie stosu kart w dół”).
// Złożony: pod spodem pierwsza warstwa, na wierzchu ostatnia, między nimi przycisk „+N warstwy” z nazwami ról środkowych warstw.
// Bez JS (i po kliknięciu) stos jest zwykłą listą wszystkich warstw. Pakiet może mieć 2 warianty (Kacper 28.11: od A do Z = WordPress / Kod od zera) z przełącznikiem; bez JS widać oba. Makieta: „WordPress (headless)”, kod: Keystatic (decyzja CMS 24.11).
import S10Stos from './S10Stos.astro';
interface Props { t: any }
const { t } = Astro.props;
const warstwy = (n: number) => (n === 1 ? 'warstwa' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'warstwy' : 'warstw');
---
<section class="s10 baza segment" id="technologie" data-segment="S10 Technologie" aria-labelledby="s10-h">
  <div class="kontener s10-wnetrze">
    <header class="s10-naglowek">
      <p class="t-etykieta akcentowy">{t.etykieta}</p>
      <h2 id="s10-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
    </header>
    <div class="kolumny">
      {t.pakiety.map((p: any, k: number) => {
        const war = (p.warianty ?? []).filter((v: any) => v.warstwy?.length);
        const n = war.length ? war[0].warstwy.length : p.warstwy.length;
        return (
          <article class="kolumna w1" aria-labelledby={`s10-p${k}`} data-pakiet-warianty={war.length > 1 ? '' : undefined}>
            <div class="kol-naglowek">
              <div class="kol-tytul">
                <h3 id={`s10-p${k}`} class="t-h4 naglowkowy">{p.nazwa}</h3>
                {p.znacznik && <p class:list={['t-etykieta', 'znacznik-pakietu', { pelny: k === 2 }]}>{p.znacznik}</p>}
              </div>
              <p class="licznik"><span class="t-liczba akcentowy" data-licznik-warstw>{n}</span> <span class="t-maly pomocniczy" data-licznik-slowo>{warstwy(n)}</span></p>
            </div>
            {p.opis && <p class="t-maly pomocniczy">{p.opis}</p>}
            {war.length > 1 && (
              <div class="przelacznik" role="group" aria-label={`Wersja pakietu ${p.nazwa}`} data-warianty-przelacznik hidden>
                {war.map((v: any, i: number) => (
                  <button type="button" class="t-maly" aria-pressed={i === 0 ? 'true' : 'false'} data-wariant-przycisk={i} data-liczba={v.warstwy.length} data-slowo={warstwy(v.warstwy.length)}>{v.etykieta}</button>
                ))}
              </div>
            )}
            {war.length
              ? war.map((v: any, i: number) => (
                  <div class="wariant" data-wariant={i}>
                    <p class="t-przycisk naglowkowy wariant-tytul">{v.etykieta}</p>
                    {v.opis && <p class="t-maly pomocniczy">{v.opis}</p>}
                    <S10Stos w={v.warstwy} />
                  </div>
                ))
              : <S10Stos w={p.warstwy} />}
          </article>
        );
      })}
    </div>
    <p class="t-maly pomocniczy">{t.podpis}</p>
  </div>
</section>

<style>
  .s10 { padding-block: clamp(40px, 3vw, 38px) 29px; }
  .s10-wnetrze { display: grid; gap: 32px; }
  .s10-naglowek { display: grid; gap: 12px; max-width: 794px; }
  .kolumny { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .kolumna { display: grid; gap: 16px; padding: 20px; border-radius: var(--radius-card); border: 1px solid var(--fk-obrys); }
  .kol-naglowek { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
  .kol-tytul { display: grid; gap: 8px; justify-items: start; }
  .znacznik-pakietu { padding: 4px 12px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo-powierzchnia); color: var(--fk-tekst-naglowek); }
  .znacznik-pakietu.pelny { background: var(--fk-akcent); border-color: var(--fk-akcent); color: var(--fk-tekst-na-akcencie); }
  .licznik { display: flex; align-items: baseline; gap: 8px; white-space: nowrap; }

  .przelacznik { display: inline-flex; justify-self: start; gap: 4px; padding: 4px; border-radius: var(--radius-pill); border: 1px solid var(--fk-obrys-kontrolka); background: var(--fk-tlo-powierzchnia); }
  .przelacznik button { padding: 6px 14px; border-radius: var(--radius-pill); border: 0; background: transparent; color: var(--fk-tekst); cursor: pointer; }
  .przelacznik button[aria-pressed='true'] { background: var(--fk-akcent); color: var(--fk-tekst-na-akcencie); }
  .przelacznik button:hover:not([aria-pressed='true']) { background: var(--fk-tlo-podniesione); }
  .wariant { display: grid; gap: 12px; }
  [data-pakiet-warianty].z-przelacznikiem .wariant-tytul { display: none; }
  @media (max-width: 1023.98px) {
    .kolumny { grid-template-columns: 1fr; }
  }
</style>
