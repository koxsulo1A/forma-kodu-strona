---
// 27 S7 Proces (wariant G: pionowa oś z węzłami). Krok 1 rozwinięty (My robimy / Ty robisz / Ty dostajesz),
// kroki 2–5 zwinięte do „Ty robisz”, krok 6 w kolorze przełamania, krok 7 „Start” z przyciskiem (otwiera sheet „Opisz projekt”).
// Ruch (tabela 390:2): linia osi rośnie ze scrollem, węzły zapalają się, gdy linia je dosięgnie; klik w tytuł rozwija krok (jeden naraz). Kod: ruch.ts, punkt 4.
// Puste pola „my_robimy”/„ty_dostajesz” w panelu = kolumna się nie pokazuje (bez wymyślania treści).
interface Props { t: any }
const { t } = Astro.props;
const n = t.etapy.length;
---
<section class="s7 baza segment" id="proces" data-segment="S7 Proces" aria-labelledby="s7-h">
  <div class="kontener s7-wnetrze">
    <header class="s7-naglowek">
      <h2 id="s7-h" class="t-h2 naglowkowy">{t.naglowek}</h2>
      <p class="t-tresc-l">{t.lead}</p>
    </header>
    <ol class="os" role="list" data-os-procesu>
      {t.etapy.map((e: any, i: number) => {
        const szczegoly = [
          ['My robimy', e.my_robimy],
          ['Ty robisz', e.ty_robisz],
          ['Ty dostajesz', e.ty_dostajesz],
        ].filter(([, v]) => v);
        const pierwszy = i === 0;
        const ostatni = i === n - 1;
        return (
          <li class:list={['krok', { rozwiniety: pierwszy, przelamanie: ostatni }]} data-krok-procesu>
            <span class="wezel t-h4" aria-hidden="true">{i + 1}</span>
            <div class="tresc">
              <h3 class="t-h4"><button type="button" class="krok-przycisk" data-krok-przycisk aria-expanded={String(pierwszy)} aria-controls={`s7-krok-${i}`}><span class="sr-only">Etap {i + 1}: </span>{e.tytul}</button></h3>
              <dl class="szczegoly" id={`s7-krok-${i}`}>
                {szczegoly.map(([k, v]) => <div class:list={{ zwiniete: k !== 'Ty robisz' }}><dt class="t-maly-mocny">{k}</dt><dd class="t-maly">{v}</dd></div>)}
              </dl>
            </div>
          </li>
        );
      })}
      <li class="krok start">
        <span class="wezel" aria-hidden="true"></span>
        <div class="tresc">
          <h3 class="t-h4 naglowkowy">{t.efekt.tytul}</h3>
          <p class="t-tresc">{t.efekt.opis}</p>
          <a class="przycisk przycisk--glowny" href="/kontakt" data-otworz-sheet="sheet-projekt" aria-haspopup="dialog">{t.efekt.cta}</a>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .s7 { padding-block: clamp(48px, 6.5vw, 90px) clamp(48px, 5.5vw, 77px); }
  .s7-wnetrze { display: grid; gap: clamp(32px, 4.5vw, 64px); }
  .s7-naglowek { display: grid; gap: 16px; max-width: 760px; }
  .os { position: relative; display: grid; gap: 12px; }
  .os::before { content: ''; position: absolute; left: 27px; top: 28px; bottom: 120px; width: 2px; background: var(--fk-obrys); }
  .krok { position: relative; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 24px; align-items: start; }
  .wezel { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--fk-tlo); border: 2px solid var(--fk-obrys-kontrolka); color: var(--fk-tekst-pomocniczy); }
  .tresc { display: flex; align-items: center; gap: 32px; padding: 16px 28px; border-radius: var(--radius-card); background: var(--fk-tlo); border: 1px solid var(--fk-obrys); color: var(--fk-tekst); min-height: 80px; }
  .tresc h3 { color: var(--fk-tekst-naglowek); min-width: 180px; }
  .szczegoly { display: flex; gap: 32px; flex: 1; }
  .szczegoly div { display: grid; gap: 4px; flex: 1; }
  .szczegoly dt { color: var(--fk-tekst-pomocniczy); }
  .rozwiniety .wezel { background: var(--fk-sukces-jasne-tlo); border: 4px solid var(--fk-kafel-1-tlo); color: var(--fk-sukces-jasne-tekst); }
  .rozwiniety .tresc { display: grid; gap: 20px; padding: 24px 28px; background: var(--fk-tlo-powierzchnia); border-color: var(--fk-akcent); }
  .przelamanie .tresc { background: var(--fk-przelamanie); border-color: var(--fk-przelamanie); color: var(--fk-przelamanie-tekst); }
  .przelamanie .tresc h3, .przelamanie dt { color: var(--fk-przelamanie-tekst); }
  .start .wezel { background: var(--fk-krok-koncowy); border: 0; }
  .start .tresc { display: grid; justify-items: start; gap: 16px; padding: 24px 28px; background: var(--fk-tlo-powierzchnia); border-color: var(--fk-krok-koncowy); }
  /* Ruch: linia akcentu rośnie ze scrollem (--postep-osi z ruch.ts), węzeł aktywny 200 ms, rozwinięcie 280 ms. */
  .os::after { content: ''; position: absolute; left: 27px; top: 28px; bottom: 120px; width: 2px; background: var(--fk-akcent); transform-origin: top; transform: scaleY(var(--postep-osi, 1)); }
  .wezel { transition: background-color 200ms cubic-bezier(0.2, 0, 0.2, 1), color 200ms cubic-bezier(0.2, 0, 0.2, 1), border-color 200ms cubic-bezier(0.2, 0, 0.2, 1); position: relative; z-index: 1; }
  .krok.aktywny:not(.rozwiniety):not(.start) .wezel { background: var(--fk-akcent); border-color: var(--fk-akcent); color: var(--fk-tekst-na-akcencie); }
  .tresc { transition: background-color 160ms, border-color 160ms; }
  .krok:not(.rozwiniety) .szczegoly .zwiniete { display: none; }
  .krok-przycisk { all: unset; cursor: pointer; display: inline; border-radius: 4px; }
  .krok-przycisk:focus-visible { outline: 3px solid var(--fk-fokus, var(--fk-akcent)); outline-offset: 4px; }
  .krok:not(.rozwiniety):not(.start) .tresc:hover { border-color: var(--fk-akcent); }
  :global(html:not(.bez-ruchu)) .rozwiniety .szczegoly { animation: krok-rozwin 280ms cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes krok-rozwin { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .wezel, .tresc { transition: none; } .rozwiniety .szczegoly { animation: none !important; } }
  @media (max-width: 1023.98px) {
    .krok { grid-template-columns: 40px minmax(0, 1fr); gap: 12px; }
    .wezel { width: 40px; height: 40px; }
    .os::before, .os::after { left: 19px; top: 20px; }
    .tresc, .rozwiniety .tresc { display: grid; gap: 12px; padding: 16px 20px; }
    .szczegoly { display: grid; gap: 12px; }
  }
</style>
